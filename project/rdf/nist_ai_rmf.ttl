	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/AiRmfCategory> .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_function_id> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_rmf_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_function_id"^^xsd:anyURI ;
