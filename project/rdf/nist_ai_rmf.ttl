<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_subcategory_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_base"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/AiRmfSubcategoryIdentifier"^^xsd:anyURI ;
	linkml:description "A subcategory's identifier, its category's identifier, a dot and a number, such as GOVERN 1.1." ;
	linkml:pattern "^(GOVERN [1-6]|MAP [1-5]|MEASURE [1-4]|MANAGE [1-4])\\.[1-9][0-9]?$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-ai-rmf/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
