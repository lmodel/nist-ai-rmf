<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_suggested_action_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_rmf_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/AiRmfSuggestedActionIdentifier"^^xsd:anyURI ;
	linkml:description "The identifier NIST's catalog gives a Playbook suggested action, such as SA-GOVERN_1.1-1. Each further number, as in SA-GOVERN_1.4-1.2, marks a sub-item." ;
