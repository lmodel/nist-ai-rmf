	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/AiRmfFunction> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_harm_category> a linkml:SlotDefinition ;
	linkml:description "The heading of Figure 1 the harm falls under." ;
	linkml:equals_string "ecosystem" , "organization" , "people" ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/AiRmfHarmCategory> ;
	linkml:required true ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_harm_example> a linkml:SlotDefinition ;
	linkml:any_of _:c14n11 , _:c14n15 , _:c14n24 , _:c14n42 , _:c14n45 , _:c14n51 , _:c14n55 , _:c14n58 , _:c14n7 ;
	linkml:description "The example of Figure 1 the harm matches, which must sit under the harm's category." ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/AiRmfHarmExample> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_human_ai_issue_number> a linkml:SlotDefinition ;
	linkml:description "The issue's number in Appendix C." ;
	linkml:minimum_value "1"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/integer> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_human_ai_issues> a linkml:SlotDefinition ;
