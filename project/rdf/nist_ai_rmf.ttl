	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-rmf/metadata_recording> dcterms:title "Metadata recording" ;
	linkml:description "Recording facts about the content, such as its creator, date and sources." .
<https://w3id.org/lmodel/nist-ai-rmf/misuse_by_humans> dcterms:title "Misuse by humans" ;
	linkml:description "Risks from malicious use." .
<https://w3id.org/lmodel/nist-ai-rmf/mitigating> dcterms:title "Mitigating" ;
	linkml:description "Reducing the likelihood or magnitude of the risk." .
<https://w3id.org/lmodel/nist-ai-rmf/model_or_system> dcterms:title "Model or system" ;
	linkml:description "The level of one model or system." .
<https://w3id.org/lmodel/nist-ai-rmf/monitoring> dcterms:title "Monitoring" .
<https://w3id.org/lmodel/nist-ai-rmf/natural_resources_and_environment> dcterms:title "Natural resources, the environment, and planet" ;
	linkml:description "To the natural world." .
