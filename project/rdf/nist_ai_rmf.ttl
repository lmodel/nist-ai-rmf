	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_rmf_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_documentation_id"^^xsd:anyURI ;
	linkml:description "The documentation prompt's identifier, such as D-GOVERN_1.1-1." ;
