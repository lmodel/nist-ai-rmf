	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/AiRmfLifecycleStageName> .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_risk_priority> a linkml:SlotDefinition ;
	skos:note "MANAGE 1.3 speaks of risks deemed high priority and the publication sets no scale, so this is text." ;
