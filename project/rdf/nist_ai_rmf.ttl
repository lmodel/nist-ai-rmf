	linkml:required true .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_characteristic_relates_to_all> a linkml:SlotDefinition ;
	linkml:description "Whether Figure 4 shows it relating to all the others." ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/boolean> .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_characteristic_section> a linkml:SlotDefinition ;
