	linkml:slot_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_category_id"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_category_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_base"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/AiRmfCategoryIdentifier"^^xsd:anyURI ;
	linkml:description "A category's identifier, its function's name and a number, such as GOVERN 1." ;
	linkml:pattern "^(GOVERN [1-6]|MAP [1-5]|MEASURE [1-4]|MANAGE [1-4])$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-ai-rmf/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_category_subcategories> a linkml:SlotDefinition ;
	linkml:description "The subcategories of the category. A knowledge bundle relates a subcategory to its category with isPartOf instead." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/AiRmfSubcategory> .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_characteristic_is_base> a linkml:SlotDefinition ;
	linkml:description "Whether Figure 4 shows it as the necessary condition under the others." ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/boolean> .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_characteristic_name> a linkml:SlotDefinition ;
