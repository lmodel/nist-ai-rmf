<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_profile_setting> a linkml:SlotDefinition ;
	linkml:description "The sector, industry, technology, organization or end use the profile covers, such as hiring." .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_profile_subcategories> a linkml:SlotDefinition ;
	linkml:description "The subcategories the profile selects. An adopter may select from them rather than apply all." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_subcategory_identifier> .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_resource_address> a linkml:SlotDefinition ;
	linkml:description "The address NIST's catalog gives the source. The catalog gives none for a few." ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/uri> .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_resource_uuid> a linkml:SlotDefinition ;
	linkml:description "The UUID of the resource in the back matter of NIST's catalog." ;
	linkml:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" ;
