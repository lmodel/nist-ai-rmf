<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_function_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_base"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/AiRmfFunctionIdentifier"^^xsd:anyURI ;
	linkml:description "The name of one of the four Core functions, written in capitals, such as GOVERN." ;
	linkml:pattern "^(GOVERN|MAP|MEASURE|MANAGE)$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-ai-rmf/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_functions> a linkml:SlotDefinition ;
