	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_id"^^xsd:anyURI ;
	linkml:description "The identifier an adopter gives a record of its own." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-ai-rmf/AiRmfRecord> ;
	linkml:identifier true ;
	linkml:owner <https://w3id.org/lmodel/nist-ai-rmf/AiRmfRecord> ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/uriorcurie> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_id"^^xsd:anyURI .
