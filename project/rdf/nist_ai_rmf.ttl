	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_likelihood"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_magnitude> a linkml:SlotDefinition ;
