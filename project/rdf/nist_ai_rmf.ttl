	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/AiRmfMeasurementChallengeName> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_profile_kinds> a linkml:SlotDefinition ;
	linkml:description "Which of the publication's kinds of profile this is. A current profile for one use case is both." ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/AiRmfProfileKind> ;
