	linkml:range <https://w3id.org/lmodel/nist-ai-rmf/AiRmfSystem> .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_risk_tolerance> a linkml:SlotDefinition ;
	linkml:description "The risk tolerance the risk is judged against, which GOVERN 1.3 and MAP 1.5 ask an adopter to document." ;
