	linkml:slot_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_documentation_id"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_documentation_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_rmf_core"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/AiRmfDocumentationIdentifier"^^xsd:anyURI ;
	linkml:description "The identifier NIST's catalog gives a Playbook documentation prompt, such as D-GOVERN_1.1-1." ;
	linkml:pattern "^D-(GOVERN|MAP|MEASURE|MANAGE)_[1-6]\\.[1-9][0-9]?-[1-9][0-9]?$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-ai-rmf/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-ai-rmf/ai_rmf_function_categories> a linkml:SlotDefinition ;
