	skos:inScheme "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_base"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-ai-100-1/ai_rmf_subcategory_id"^^xsd:anyURI ;
