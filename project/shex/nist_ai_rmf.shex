             <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] ;
          nist_ai_100_1:includes_tevv @linkml:Boolean ?
       ) ;
       rdf:type [ nist_ai_100_1:AiLifecycleStage ]
    )
}

nist_ai_600_1:AiRedTeaming CLOSED {
    (  $nist_ai_600_1:AiRedTeaming_tes (  &nist_ai_600_1:StructuredPublicFeedback_tes ;
          rdf:type [ nist_ai_600_1:StructuredPublicFeedback ] ? ;
          nist_ai_600_1:red_team_type [ <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#GENERAL_PUBLIC>
             <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#EXPERT>
             <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#COMBINATION>
             <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#HUMAN_AND_AI> ] ? ;
          nist_ai_600_1:feedback_method_kind [
             <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#PARTICIPATORY_ENGAGEMENT_METHODS>
             <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#FIELD_TESTING>
             <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#AI_RED_TEAMING> ]
       ) ;
       rdf:type [ nist_ai_600_1:AiRedTeaming ]
    )
}

nist_ai_100_1:AiRmfDocument CLOSED {
    (  $nist_ai_100_1:AiRmfDocument_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ? ;
          schema1:version @linkml:String ? ;
          dcterms:publisher @linkml:String ? ;
          nist_ai_100_1:doi @linkml:Uriorcurie ? ;
          dcterms:issued @linkml:Date ? ;
          dcterms:source @linkml:Uriorcurie ?
       ) ;
       rdf:type [ nist_ai_100_1:AiRmfDocument ]
    )
}

nist_ai_100_1:AiRmfFramework CLOSED {
    (  $nist_ai_100_1:AiRmfFramework_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_100_1:document @nist_ai_100_1:AiRmfDocument ? ;
          nist_ai_100_1:functions @nist_ai_100_1:Function * ;
          nist_ai_100_1:trustworthiness_characteristics @nist_ai_100_1:TrustworthinessCharacteristic * ;
          nist_ai_100_1:lifecycle_stages @nist_ai_100_1:AiLifecycleStage * ;
          nist_ai_100_1:dimensions @nist_ai_100_1:AiSystemDimension * ;
          nist_ai_100_1:actor_tasks @nist_ai_100_1:AiActorTask * ;
          nist_ai_100_1:profiles @nist_ai_100_1:AiRmfProfile * ;
          nist_ai_100_1:attributes @nist_ai_100_1:RmfAttribute * ;
          nist_ai_100_1:risk_measurement_challenges @nist_ai_100_1:RiskMeasurementChallenge * ;
          nist_ai_100_1:ai_specific_risks @nist_ai_100_1:AiSpecificRisk * ;
          nist_ai_100_1:human_ai_interaction_issues @nist_ai_100_1:HumanAiInteractionIssue *
       ) ;
       rdf:type [ nist_ai_100_1:AiRmfFramework ]
    )
}

nist_ai_100_1:AiRmfProfile CLOSED {
