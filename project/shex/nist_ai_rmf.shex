nist_ai_600_1:GaiRisk CLOSED {
    (  $nist_ai_600_1:GaiRisk_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_600_1:gai_risk_kind [
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#CBRN_INFORMATION_OR_CAPABILITIES>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#CONFABULATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#DATA_PRIVACY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#ENVIRONMENTAL_IMPACTS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#HARMFUL_BIAS_OR_HOMOGENIZATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#HUMAN_AI_CONFIGURATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INFORMATION_INTEGRITY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INFORMATION_SECURITY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INTELLECTUAL_PROPERTY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#OBSCENE_DEGRADING_OR_ABUSIVE_CONTENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#VALUE_CHAIN_AND_COMPONENT_INTEGRATION> ] ? ;
          nist_ai_600_1:risk_categorization [
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#TECHNICAL_OR_MODEL_RISKS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#MISUSE_BY_HUMANS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#ECOSYSTEM_OR_SOCIETAL_RISKS> ] ? ;
          nist_ai_600_1:risk_scope [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#MODEL_OR_SYSTEM>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#APPLICATION_OR_IMPLEMENTATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#ECOSYSTEM> ] * ;
          nist_ai_600_1:risk_sources [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#DESIGN>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#TRAINING>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#OPERATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#MODEL_INPUTS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#MODEL_OUTPUTS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#HUMAN_BEHAVIOR>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#HUMAN_AI_INTERACTION> ] * ;
          nist_ai_600_1:time_scale [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum#IMMEDIATE>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum#PROLONGED> ] * ;
          nist_ai_100_1:trustworthiness_characteristic [
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#SAFE>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> ] * ;
          nist_ai_600_1:addressed_by_actions @nist_ai_600_1:SuggestedAction * ;
          nist_ai_600_1:lifecycle_stage [ <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DESIGN>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEVELOPMENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DEPLOYMENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#OPERATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiLifecycleStageEnum#DECOMMISSIONING> ] *
       ) ;
       rdf:type [ nist_ai_600_1:GaiRisk ]
    )
}

nist_ai_100_1:Harm CLOSED {
    (  $nist_ai_100_1:Harm_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_100_1:harm_category [ <https://w3id.org/lmodel/nist-ai-100-1/HarmCategoryEnum#HARM_TO_PEOPLE>
             <https://w3id.org/lmodel/nist-ai-100-1/HarmCategoryEnum#HARM_TO_AN_ORGANIZATION>
             <https://w3id.org/lmodel/nist-ai-100-1/HarmCategoryEnum#HARM_TO_AN_ECOSYSTEM> ] ? ;
          nist_ai_100_1:harm_to_people_subcategory [ <https://w3id.org/lmodel/nist-ai-100-1/HarmToPeopleSubcategoryEnum#INDIVIDUAL>
             <https://w3id.org/lmodel/nist-ai-100-1/HarmToPeopleSubcategoryEnum#GROUP_OR_COMMUNITY>
             <https://w3id.org/lmodel/nist-ai-100-1/HarmToPeopleSubcategoryEnum#SOCIETAL> ] ? ;
          nist_ai_100_1:magnitude @linkml:String ? ;
          nist_ai_100_1:affects @nist_ai_100_1:NamedThing *
       ) ;
       rdf:type [ nist_ai_100_1:Harm ]
    )
}

nist_ai_100_1:HumanAiInteractionIssue CLOSED {
    (  $nist_ai_100_1:HumanAiInteractionIssue_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ?
       ) ;
       rdf:type [ nist_ai_100_1:HumanAiInteractionIssue ]
    )
}

nist_ai_100_1:Impact CLOSED {
    (  $nist_ai_100_1:Impact_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_100_1:impact_sign [ <https://w3id.org/lmodel/nist-ai-100-1/ImpactSignEnum#POSITIVE>
             <https://w3id.org/lmodel/nist-ai-100-1/ImpactSignEnum#NEGATIVE>
             <https://w3id.org/lmodel/nist-ai-100-1/ImpactSignEnum#MIXED> ] ? ;
          nist_ai_100_1:magnitude @linkml:String ? ;
          nist_ai_100_1:likelihood @linkml:Float ? ;
          nist_ai_100_1:affects @nist_ai_100_1:NamedThing *
       ) ;
       rdf:type [ nist_ai_100_1:Impact ]
    )
}

nist_ai_100_1:NamedThing  (
    @nist_ai_100_1:AiActor OR @nist_ai_100_1:AiActorTask OR @nist_ai_100_1:AiLifecycleStage OR @nist_ai_100_1:AiRmfDocument OR
    @nist_ai_100_1:AiRmfFramework OR @nist_ai_100_1:AiRmfProfile OR @nist_ai_100_1:AiSpecificRisk OR @nist_ai_100_1:AiSystem OR
    @nist_ai_100_1:AiSystemDimension OR @nist_ai_100_1:Bias OR @nist_ai_100_1:Category OR @nist_ai_100_1:Function OR
    @nist_ai_600_1:GaiProfile OR @nist_ai_600_1:GaiRisk OR @nist_ai_100_1:Harm OR @nist_ai_100_1:HumanAiInteractionIssue OR
    @nist_ai_100_1:Impact OR @nist_ai_600_1:PrimaryGaiConsideration OR @nist_ai_100_1:Risk OR
    @nist_ai_100_1:RiskMeasurementChallenge OR @nist_ai_100_1:RiskTolerance OR @nist_ai_100_1:RmfAttribute OR
    @nist_ai_600_1:StructuredPublicFeedback OR @nist_ai_100_1:Subcategory OR @nist_ai_600_1:SuggestedAction OR
    @nist_ai_100_1:TrustworthinessCharacteristic
)

nist_ai_100_1:NamedThing_struct {
    (  $nist_ai_100_1:NamedThing_tes (  rdfs:label @linkml:String ? ;
          dcterms:title @linkml:String ? ;
          dcterms:description @linkml:String ? ;
          rdfs:seeAlso @linkml:Uriorcurie *
       ) ;
       rdf:type [ schema1:Thing ]
    )
}

nist_ai_100_1:PlaybookCollection CLOSED {
    (  $nist_ai_100_1:PlaybookCollection_tes nist_ai_100_1:entries @nist_ai_100_1:PlaybookEntry * ;
       rdf:type [ nist_ai_100_1:PlaybookCollection ] ?
    )
}

nist_ai_100_1:PlaybookEntry CLOSED {
    (  $nist_ai_100_1:PlaybookEntry_tes (  nist_ai_100_1:type @linkml:String ? ;
          nist_ai_100_1:title @linkml:String ? ;
          nist_ai_100_1:category @linkml:String ? ;
          nist_ai_100_1:description @linkml:String ? ;
          nist_ai_100_1:section_about @linkml:String ? ;
          nist_ai_100_1:section_actions @linkml:String ? ;
          nist_ai_100_1:section_doc @linkml:String ? ;
          nist_ai_100_1:section_ref @linkml:String ? ;
          nist_ai_100_1:ai_actors @linkml:String * ;
          nist_ai_100_1:topic @linkml:String *
       ) ;
       rdf:type [ nist_ai_100_1:PlaybookEntry ] ?
    )
}

nist_ai_600_1:PrimaryGaiConsideration CLOSED {
    (  $nist_ai_600_1:PrimaryGaiConsideration_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_600_1:consideration_kind [ <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#GOVERNANCE>
             <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#PRE_DEPLOYMENT_TESTING>
             <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#CONTENT_PROVENANCE>
             <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#INCIDENT_DISCLOSURE> ] ;
          nist_ai_600_1:governance_practices [
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#ACCESSIBILITY_AND_REASONABLE_ACCOMMODATIONS>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#AI_ACTOR_CREDENTIALS_AND_QUALIFICATIONS>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#ALIGNMENT_TO_ORGANIZATIONAL_VALUES>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#AUDITING_AND_ASSESSMENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#CHANGE_MANAGEMENT_CONTROLS>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#COMMERCIAL_USE>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#DATA_PROVENANCE>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#DATA_PROTECTION>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#DATA_RETENTION>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#CONSISTENCY_IN_USE_OF_DEFINING_KEY_TERMS>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#DECOMMISSIONING>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#DISCOURAGING_ANONYMOUS_USE>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#EDUCATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#IMPACT_ASSESSMENTS>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#INCIDENT_RESPONSE>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#MONITORING>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#OPT_OUTS>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#RISK_BASED_CONTROLS>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#RISK_MAPPING_AND_MEASUREMENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#SCIENCE_BACKED_TEVV_PRACTICES>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#SECURE_SOFTWARE_DEVELOPMENT_PRACTICES>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#STAKEHOLDER_ENGAGEMENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#SYNTHETIC_CONTENT_DETECTION_AND_LABELING>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#WHISTLEBLOWER_PROTECTIONS>
             <https://w3id.org/lmodel/nist-ai-600-1/GovernancePracticeEnum#WORKFORCE_DIVERSITY_AND_INTERDISCIPLINARY_TEAMS> ] * ;
          nist_ai_600_1:third_party_considerations @linkml:String ? ;
          nist_ai_600_1:limitations_of_current_approaches @linkml:String ? ;
          nist_ai_600_1:provenance_techniques [
             <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#DIGITAL_WATERMARKING>
             <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#METADATA_RECORDING>
             <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#DIGITAL_FINGERPRINTING>
             <https://w3id.org/lmodel/nist-ai-600-1/ProvenanceTechniqueEnum#HUMAN_AUTHENTICATION> ] * ;
          nist_ai_600_1:ai_incident_definition @linkml:String ?
       ) ;
       rdf:type [ nist_ai_600_1:PrimaryGaiConsideration ]
    )
}

nist_ai_100_1:ResidualRisk CLOSED {
    (  $nist_ai_100_1:ResidualRisk_tes (  &nist_ai_100_1:Risk_tes ;
          rdf:type [ nist_ai_100_1:Risk ] ? ;
          nist_ai_100_1:is_residual @linkml:Boolean ?
       ) ;
       rdf:type [ nist_ai_100_1:ResidualRisk ]
    )
}

nist_ai_100_1:Risk  (
    CLOSED {
       (  $nist_ai_100_1:Risk_tes (  &nist_ai_100_1:NamedThing_tes ;
             rdf:type [ schema1:Thing ] ? ;
             nist_ai_100_1:likelihood @linkml:Float ? ;
             nist_ai_100_1:magnitude @linkml:String ? ;
             nist_ai_100_1:impact_sign [ <https://w3id.org/lmodel/nist-ai-100-1/ImpactSignEnum#POSITIVE>
                <https://w3id.org/lmodel/nist-ai-100-1/ImpactSignEnum#NEGATIVE>
                <https://w3id.org/lmodel/nist-ai-100-1/ImpactSignEnum#MIXED> ] ? ;
             nist_ai_100_1:is_residual @linkml:Boolean ? ;
             nist_ai_100_1:risk_response [ <https://w3id.org/lmodel/nist-ai-100-1/RiskResponseEnum#MITIGATING>
                <https://w3id.org/lmodel/nist-ai-100-1/RiskResponseEnum#TRANSFERRING>
                <https://w3id.org/lmodel/nist-ai-100-1/RiskResponseEnum#AVOIDING>
                <https://w3id.org/lmodel/nist-ai-100-1/RiskResponseEnum#ACCEPTING> ] ? ;
             nist_ai_100_1:lifecycle_stage [ <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#PLAN_AND_DESIGN>
                <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>
                <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>
                <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#VERIFY_AND_VALIDATE>
                <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#DEPLOY_AND_USE>
                <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] * ;
             nist_ai_100_1:trustworthiness_characteristic [
                <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE>
                <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#SAFE>
                <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT>
                <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT>
                <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE>
                <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED>
                <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> ] * ;
             nist_ai_100_1:related_impacts @nist_ai_100_1:Impact * ;
             nist_ai_100_1:affects_system @nist_ai_100_1:AiSystem ?
          ) ;
          rdf:type [ nist_ai_100_1:Risk ]
       )
    } OR @nist_ai_100_1:ResidualRisk
)

nist_ai_100_1:RiskMeasurementChallenge CLOSED {
    (  $nist_ai_100_1:RiskMeasurementChallenge_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_100_1:challenge_kind [
             <https://w3id.org/lmodel/nist-ai-100-1/RiskMeasurementChallengeEnum#THIRD_PARTY_SOFTWARE_HARDWARE_AND_DATA>
             <https://w3id.org/lmodel/nist-ai-100-1/RiskMeasurementChallengeEnum#TRACKING_EMERGENT_RISKS>
             <https://w3id.org/lmodel/nist-ai-100-1/RiskMeasurementChallengeEnum#AVAILABILITY_OF_RELIABLE_METRICS>
             <https://w3id.org/lmodel/nist-ai-100-1/RiskMeasurementChallengeEnum#RISK_AT_DIFFERENT_LIFECYCLE_STAGES>
             <https://w3id.org/lmodel/nist-ai-100-1/RiskMeasurementChallengeEnum#RISK_IN_REAL_WORLD_SETTINGS>
             <https://w3id.org/lmodel/nist-ai-100-1/RiskMeasurementChallengeEnum#INSCRUTABILITY>
             <https://w3id.org/lmodel/nist-ai-100-1/RiskMeasurementChallengeEnum#HUMAN_BASELINE> ]
       ) ;
       rdf:type [ nist_ai_100_1:RiskMeasurementChallenge ]
    )
}

nist_ai_100_1:RiskTolerance CLOSED {
    (  $nist_ai_100_1:RiskTolerance_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_100_1:tolerance_statement @linkml:String ? ;
          nist_ai_100_1:legal_basis @linkml:String ?
       ) ;
       rdf:type [ nist_ai_100_1:RiskTolerance ]
    )
}

nist_ai_100_1:RmfAttribute CLOSED {
    (  $nist_ai_100_1:RmfAttribute_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ?
       ) ;
       rdf:type [ nist_ai_100_1:RmfAttribute ]
    )
}

nist_ai_600_1:StructuredPublicFeedback  (
    CLOSED {
       (  $nist_ai_600_1:StructuredPublicFeedback_tes (  &nist_ai_100_1:NamedThing_tes ;
             rdf:type [ schema1:Thing ] ? ;
             nist_ai_600_1:feedback_method_kind [
                <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#PARTICIPATORY_ENGAGEMENT_METHODS>
                <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#FIELD_TESTING>
                <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#AI_RED_TEAMING> ]
          ) ;
          rdf:type [ nist_ai_600_1:StructuredPublicFeedback ]
       )
    } OR @nist_ai_600_1:AiRedTeaming
)

nist_ai_100_1:Subcategory CLOSED {
    (  $nist_ai_100_1:Subcategory_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_100_1:subcategory_id @nist_ai_100_1:SubcategoryCode ? ;
          nist_ai_100_1:outcome @linkml:String ? ;
          nist_ai_100_1:trustworthiness_characteristic [
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#SAFE>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED>
             <https://w3id.org/lmodel/nist-ai-100-1/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> ] * ;
          nist_ai_100_1:lifecycle_stage [ <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#PLAN_AND_DESIGN>
             <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>
             <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>
             <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#VERIFY_AND_VALIDATE>
             <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#DEPLOY_AND_USE>
             <https://w3id.org/lmodel/nist-ai-100-1/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] * ;
          nist_ai_100_1:about_text @linkml:String ? ;
          nist_ai_100_1:suggested_actions_text @linkml:String ? ;
          nist_ai_100_1:documentation_questions @linkml:String ? ;
          nist_ai_100_1:references_text @linkml:String ? ;
          nist_ai_100_1:topics @linkml:String * ;
          nist_ai_100_1:ai_actor_categories @linkml:String *
       ) ;
       rdf:type [ nist_ai_100_1:Subcategory ]
    )
}

nist_ai_600_1:SuggestedAction CLOSED {
    (  $nist_ai_600_1:SuggestedAction_tes (  &nist_ai_100_1:NamedThing_tes ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_600_1:action_id @nist_ai_600_1:GaiActionId ;
          nist_ai_600_1:function_prefix [ <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#GV>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MP>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MG> ] ? ;
          nist_ai_600_1:applies_to_subcategory @nist_ai_100_1:SubcategoryCode ? ;
          nist_ai_600_1:gai_risks [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#CBRN_INFORMATION_OR_CAPABILITIES>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#CONFABULATION>
