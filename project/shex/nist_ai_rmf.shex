# metamodel_version: 1.12.0
# version: 1.0.0
BASE <https://w3id.org/lmodel/nist-ai-rmf/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX schema1: <http://schema.org/>
PREFIX nist_ai_100_1: <https://w3id.org/lmodel/nist-ai-100-1/>
PREFIX nist_ai_600_1: <https://w3id.org/lmodel/nist-ai-600-1/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

nist_ai_100_1:AiRmfFunctionIdentifier xsd:string

nist_ai_100_1:AiRmfCategoryIdentifier xsd:string

nist_ai_100_1:AiRmfSubcategoryIdentifier xsd:string

nist_ai_100_1:AiRmfSuggestedActionIdentifier xsd:string

nist_ai_100_1:AiRmfDocumentationIdentifier xsd:string

nist_ai_600_1:GaiActionIdentifier xsd:string

nist_ai_100_1:AiRmfActor CLOSED {
    (  $nist_ai_100_1:AiRmfActor_tes (  &nist_ai_100_1:AiRmfRecord_tes ;
          rdf:type [ nist_ai_100_1:Record ] ? ;
          nist_ai_100_1:ai_rmf_actor_tasks [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_design>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_development>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_deployment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#operation_and_monitoring>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#tevv>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#human_factors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#domain_expert>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_impact_assessment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#procurement>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#governance_and_oversight>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#third_party_entities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#end_users>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#affected_individuals_and_communities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#other_ai_actors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#general_public> ] * ;
          nist_ai_100_1:ai_rmf_actor_audience [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAudience#primary>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAudience#informing> ] ? ;
          nist_ai_100_1:ai_rmf_actor_lifecycle_stages [
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#plan_and_design>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#collect_and_process_data>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#build_and_use_model>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#verify_and_validate>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#deploy_and_use>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#operate_and_monitor>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#use_or_impacted_by> ] *
       ) ;
       rdf:type [ nist_ai_100_1:AiActor ]
    )
}

nist_ai_100_1:AiRmfActorTask CLOSED {
    (  $nist_ai_100_1:AiRmfActorTask_tes (  schema1:description @linkml:String ? ;
          nist_ai_100_1:ai_rmf_actor_task_name [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_design>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_development>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_deployment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#operation_and_monitoring>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#tevv>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#human_factors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#domain_expert>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#ai_impact_assessment>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#procurement>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#governance_and_oversight>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#third_party_entities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#end_users>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#affected_individuals_and_communities>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#other_ai_actors>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfActorTaskName#general_public> ] ;
          nist_ai_100_1:ai_rmf_actor_task_is_additional_actor @linkml:Boolean ? ;
          nist_ai_100_1:ai_rmf_actor_task_representative_actors @linkml:String *
       ) ;
       rdf:type [ nist_ai_100_1:ActorTask ] ?
    )
}

nist_ai_100_1:AiRmfAttribute CLOSED {
    (  $nist_ai_100_1:AiRmfAttribute_tes (  schema1:name @linkml:String ;
          schema1:description @linkml:String ? ;
          nist_ai_100_1:ai_rmf_attribute_number @linkml:Integer
       ) ;
       rdf:type [ nist_ai_100_1:Attribute ] ?
    )
}

nist_ai_100_1:AiRmfBias CLOSED {
    (  $nist_ai_100_1:AiRmfBias_tes (  &nist_ai_100_1:AiRmfRecord_tes ;
          rdf:type [ nist_ai_100_1:Record ] ? ;
          nist_ai_100_1:ai_rmf_bias_categories [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfBiasCategory#systemic>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfBiasCategory#computational_and_statistical>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfBiasCategory#human_cognitive> ] +
       ) ;
       rdf:type [ nist_ai_100_1:Bias ]
    )
}

nist_ai_100_1:AiRmfCategory CLOSED {
    (  $nist_ai_100_1:AiRmfCategory_tes (  nist_ai_100_1:ai_rmf_category_id @nist_ai_100_1:AiRmfCategoryIdentifier ;
          schema1:description @linkml:String ;
          nist_ai_100_1:ai_rmf_category_subcategories @nist_ai_100_1:AiRmfSubcategory *
       ) ;
       rdf:type [ nist_ai_100_1:Category ] ?
    )
}

nist_ai_100_1:AiRmfDimension CLOSED {
    (  $nist_ai_100_1:AiRmfDimension_tes (  schema1:description @linkml:String ? ;
          nist_ai_100_1:ai_rmf_dimension_name [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#application_context>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#data_and_input>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#ai_model>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#task_and_output>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#people_and_planet> ] ;
          nist_ai_100_1:ai_rmf_dimension_audience [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAudience#primary>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAudience#informing> ]
       ) ;
       rdf:type [ nist_ai_100_1:Dimension ] ?
    )
}

nist_ai_100_1:AiRmfDocumentationItem CLOSED {
    (  $nist_ai_100_1:AiRmfDocumentationItem_tes (  nist_ai_100_1:ai_rmf_documentation_id
          @nist_ai_100_1:AiRmfDocumentationIdentifier ;
          schema1:description @linkml:String
       ) ;
       rdf:type [ nist_ai_100_1:DocumentationItem ] ?
    )
}

nist_ai_100_1:AiRmfFramework CLOSED {
    (  $nist_ai_100_1:AiRmfFramework_tes (  nist_ai_100_1:ai_rmf_version @linkml:String ;
          nist_ai_100_1:ai_rmf_functions @nist_ai_100_1:AiRmfFunction + ;
          nist_ai_100_1:ai_rmf_characteristics @nist_ai_100_1:AiRmfTrustworthinessCharacteristic * ;
          nist_ai_100_1:ai_rmf_dimensions @nist_ai_100_1:AiRmfDimension * ;
          nist_ai_100_1:ai_rmf_lifecycle_stages @nist_ai_100_1:AiRmfLifecycleStage * ;
          nist_ai_100_1:ai_rmf_actor_task_list @nist_ai_100_1:AiRmfActorTask * ;
          nist_ai_100_1:ai_rmf_management_challenges @nist_ai_100_1:AiRmfManagementChallenge * ;
          nist_ai_100_1:ai_rmf_specific_risks @nist_ai_100_1:AiRmfSpecificRisk * ;
          nist_ai_100_1:ai_rmf_human_ai_issues @nist_ai_100_1:AiRmfHumanAiIssue * ;
          nist_ai_100_1:ai_rmf_attributes @nist_ai_100_1:AiRmfAttribute *
       ) ;
       rdf:type [ nist_ai_100_1:Framework ] ?
    )
}

nist_ai_100_1:AiRmfFunction CLOSED {
    (  $nist_ai_100_1:AiRmfFunction_tes (  nist_ai_100_1:ai_rmf_function_id @nist_ai_100_1:AiRmfFunctionIdentifier ;
          schema1:description @linkml:String ? ;
          nist_ai_100_1:ai_rmf_function_categories @nist_ai_100_1:AiRmfCategory *
       ) ;
       rdf:type [ nist_ai_100_1:Function ] ?
    )
}

nist_ai_100_1:AiRmfHarm CLOSED {
    (  $nist_ai_100_1:AiRmfHarm_tes (  &nist_ai_100_1:AiRmfImpact_tes ;
          rdf:type [ nist_ai_100_1:Impact ] ? ;
          nist_ai_100_1:ai_rmf_harm_category [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmCategory#people>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmCategory#organization>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmCategory#ecosystem> ] ;
          nist_ai_100_1:ai_rmf_harm_example [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#individual>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#group_or_community>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#societal>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#business_operations>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#security_breach_or_monetary_loss>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#reputation>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#interdependent_elements>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#financial_or_supply_systems>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarmExample#natural_resources_and_environment> ] ?
       ) ;
       rdf:type [ nist_ai_100_1:Harm ]
    )
}

nist_ai_100_1:AiRmfHumanAiIssue CLOSED {
    (  $nist_ai_100_1:AiRmfHumanAiIssue_tes (  schema1:name @linkml:String ;
          schema1:description @linkml:String ? ;
          nist_ai_100_1:ai_rmf_human_ai_issue_number @linkml:Integer
       ) ;
       rdf:type [ nist_ai_100_1:HumanAiIssue ] ?
    )
}

nist_ai_100_1:AiRmfImpact  (
    CLOSED {
       (  $nist_ai_100_1:AiRmfImpact_tes (  &nist_ai_100_1:AiRmfRecord_tes ;
             rdf:type [ nist_ai_100_1:Record ] ? ;
             nist_ai_100_1:ai_rmf_likelihood @linkml:String ? ;
             nist_ai_100_1:ai_rmf_magnitude @linkml:String ? ;
             nist_ai_100_1:ai_rmf_impact_direction [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpactDirection#positive>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpactDirection#negative>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfImpactDirection#both> ] ;
             nist_ai_100_1:ai_rmf_impact_affected_parties [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#individuals>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#groups>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#communities>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#organizations>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#society>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#environment>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfAffectedParty#planet> ] *
          ) ;
          rdf:type [ nist_ai_100_1:Impact ]
       )
    } OR @nist_ai_100_1:AiRmfHarm
)

nist_ai_100_1:AiRmfLifecycleStage CLOSED {
    (  $nist_ai_100_1:AiRmfLifecycleStage_tes (  schema1:description @linkml:String ? ;
          nist_ai_100_1:ai_rmf_lifecycle_stage_name [
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#plan_and_design>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#collect_and_process_data>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#build_and_use_model>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#verify_and_validate>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#deploy_and_use>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#operate_and_monitor>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfLifecycleStageName#use_or_impacted_by> ] ;
          nist_ai_100_1:ai_rmf_lifecycle_stage_dimension [
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#application_context>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#data_and_input>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#ai_model>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#task_and_output>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfDimensionName#people_and_planet> ] ;
          nist_ai_100_1:ai_rmf_lifecycle_stage_tevv @linkml:String ? ;
          nist_ai_100_1:ai_rmf_lifecycle_stage_representative_actors @linkml:String *
       ) ;
       rdf:type [ nist_ai_100_1:LifecycleStage ] ?
    )
}

nist_ai_100_1:AiRmfManagementChallenge CLOSED {
    (  $nist_ai_100_1:AiRmfManagementChallenge_tes (  schema1:description @linkml:String ? ;
          nist_ai_100_1:ai_rmf_management_challenge_name [
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfManagementChallengeName#risk_measurement>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfManagementChallengeName#risk_tolerance>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfManagementChallengeName#risk_prioritization>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfManagementChallengeName#organizational_integration_and_management_of_risk>
             ] ;
          nist_ai_100_1:ai_rmf_management_challenge_measurement_challenges @nist_ai_100_1:AiRmfMeasurementChallenge *
       ) ;
       rdf:type [ nist_ai_100_1:ManagementChallenge ] ?
    )
}

nist_ai_100_1:AiRmfMeasurementChallenge CLOSED {
    (  $nist_ai_100_1:AiRmfMeasurementChallenge_tes (  schema1:description @linkml:String ? ;
          nist_ai_100_1:ai_rmf_measurement_challenge_name [
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#third_party_software_hardware_and_data>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#tracking_emergent_risks>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#availability_of_reliable_metrics>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#risk_at_different_lifecycle_stages>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#risk_in_real_world_settings>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#inscrutability>
             <https://w3id.org/lmodel/nist-ai-100-1/AiRmfMeasurementChallengeName#human_baseline> ]
       ) ;
       rdf:type [ nist_ai_100_1:MeasurementChallenge ] ?
    )
}

nist_ai_100_1:AiRmfProfile  (
    CLOSED {
       (  $nist_ai_100_1:AiRmfProfile_tes (  &nist_ai_100_1:AiRmfRecord_tes ;
             rdf:type [ nist_ai_100_1:Record ] ? ;
             nist_ai_100_1:ai_rmf_profile_kinds [ <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#use_case>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#current>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#target>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfileKind#cross_sectoral> ] + ;
             nist_ai_100_1:ai_rmf_profile_setting @linkml:String ? ;
             nist_ai_100_1:ai_rmf_profile_subcategories @nist_ai_100_1:AiRmfSubcategoryIdentifier *
          ) ;
          rdf:type [ nist_ai_100_1:Profile ]
       )
    } OR @nist_ai_600_1:GaiProfile
)

nist_ai_100_1:AiRmfRecord  (
    @nist_ai_100_1:AiRmfActor OR @nist_ai_100_1:AiRmfBias OR @nist_ai_100_1:AiRmfImpact OR @nist_ai_100_1:AiRmfProfile OR
    @nist_ai_100_1:AiRmfRisk OR @nist_ai_100_1:AiRmfRiskTolerance OR @nist_ai_100_1:AiRmfSystem
)

nist_ai_100_1:AiRmfRecord_struct {
    (  $nist_ai_100_1:AiRmfRecord_tes (  schema1:name @linkml:String ? ;
          schema1:description @linkml:String ?
       ) ;
       rdf:type [ nist_ai_100_1:Record ]
    )
}

nist_ai_100_1:AiRmfResidualRisk CLOSED {
    (  $nist_ai_100_1:AiRmfResidualRisk_tes (  &nist_ai_100_1:AiRmfRisk_tes ;
          rdf:type [ nist_ai_100_1:Risk ] ?
       ) ;
       rdf:type [ nist_ai_100_1:ResidualRisk ]
    )
}

nist_ai_100_1:AiRmfResource CLOSED {
    (  $nist_ai_100_1:AiRmfResource_tes (  schema1:name @linkml:String ;
          nist_ai_100_1:ai_rmf_resource_uuid @linkml:String ;
          nist_ai_100_1:ai_rmf_resource_address @linkml:Uri ?
       ) ;
       rdf:type [ nist_ai_100_1:Resource ] ?
    )
}

nist_ai_100_1:AiRmfRisk  (
    CLOSED {
       (  $nist_ai_100_1:AiRmfRisk_tes (  &nist_ai_100_1:AiRmfRecord_tes ;
             rdf:type [ nist_ai_100_1:Record ] ? ;
             nist_ai_100_1:ai_rmf_likelihood @linkml:String ? ;
             nist_ai_100_1:ai_rmf_magnitude @linkml:String ? ;
             nist_ai_100_1:ai_rmf_risk_system @nist_ai_100_1:AiRmfSystem ? ;
             nist_ai_100_1:ai_rmf_risk_impacts @nist_ai_100_1:AiRmfImpact * ;
             nist_ai_100_1:ai_rmf_risk_characteristics [
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#valid_and_reliable>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#safe>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#secure_and_resilient>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#accountable_and_transparent>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#explainable_and_interpretable>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#privacy_enhanced>
                <https://w3id.org/lmodel/nist-ai-100-1/AiRmfCharacteristicName#fair_with_harmful_bias_managed> ] * ;
             nist_ai_100_1:ai_rmf_risk_lifecycle_stages [
