# metamodel_version: 1.11.0
# version: 1.0.0
BASE <https://w3id.org/lmodel/nist-ai-rmf/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX nist_ai_600_1: <https://w3id.org/lmodel/nist-ai-600-1/>
PREFIX linkml: <https://w3id.org/linkml/>
PREFIX schema1: <http://schema.org/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<FunctionCode> xsd:string

<CategoryCode> xsd:string

<SubcategoryCode> xsd:string

nist_ai_600_1:GaiActionId xsd:string

<AiActor> CLOSED {
    (  $<AiActor_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <actor_task> [ <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DESIGN>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEVELOPMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEPLOYMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OPERATION_AND_MONITORING>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#TEVV>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#HUMAN_FACTORS>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#DOMAIN_EXPERT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_IMPACT_ASSESSMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#PROCUREMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GOVERNANCE_AND_OVERSIGHT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#THIRD_PARTY_ENTITIES>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#END_USERS>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AFFECTED_INDIVIDUALS_OR_COMMUNITIES>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OTHER_AI_ACTORS>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GENERAL_PUBLIC> ] * ;
          <lifecycle_stage> [ <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#PLAN_AND_DESIGN>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#VERIFY_AND_VALIDATE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#DEPLOY_AND_USE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] * ;
          <is_tevv> @linkml:Boolean ? ;
          <audience> [ <https://w3id.org/lmodel/nist-ai-rmf/AudienceEnum#PRIMARY>
             <https://w3id.org/lmodel/nist-ai-rmf/AudienceEnum#INFORMING> ] ?
       ) ;
       rdf:type [ <AiActor> ]
    )
}

<AiActorTask> CLOSED {
    (  $<AiActorTask_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <lifecycle_stage> [ <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#PLAN_AND_DESIGN>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#VERIFY_AND_VALIDATE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#DEPLOY_AND_USE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] * ;
          <ai_dimension> [ <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#APPLICATION_CONTEXT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#DATA_AND_INPUT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#AI_MODEL>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#TASK_AND_OUTPUT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#PEOPLE_AND_PLANET> ] * ;
          <task_kind> [ <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DESIGN>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEVELOPMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEPLOYMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OPERATION_AND_MONITORING>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#TEVV>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#HUMAN_FACTORS>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#DOMAIN_EXPERT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_IMPACT_ASSESSMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#PROCUREMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GOVERNANCE_AND_OVERSIGHT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#THIRD_PARTY_ENTITIES>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#END_USERS>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AFFECTED_INDIVIDUALS_OR_COMMUNITIES>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OTHER_AI_ACTORS>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GENERAL_PUBLIC> ] ;
          <typical_actors> @linkml:String *
       ) ;
       rdf:type [ <AiActorTask> ]
    )
}

<AiLifecycleStage> CLOSED {
    (  $<AiLifecycleStage_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <stage_kind> [ <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#PLAN_AND_DESIGN>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#VERIFY_AND_VALIDATE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#DEPLOY_AND_USE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] ;
          <includes_tevv> @linkml:Boolean ?
       ) ;
       rdf:type [ <AiLifecycleStage> ]
    )
}

nist_ai_600_1:AiRedTeaming CLOSED {
    (  $nist_ai_600_1:AiRedTeaming_tes (  &nist_ai_600_1:StructuredPublicFeedback_tes ;
          rdf:type [ nist_ai_600_1:StructuredPublicFeedback ] ? ;
          nist_ai_600_1:red_team_type [ <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#GENERAL_PUBLIC>
             <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#EXPERT>
             <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#COMBINATION>
             <https://w3id.org/lmodel/nist-ai-600-1/RedTeamingTypeEnum#HUMAN_AND_AI> ] ? ;
          nist_ai_600_1:feedback_method_kind [
             <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#PARTICIPATORY_ENGAGEMENT_METHODS>
             <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#FIELD_TESTING>
             <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#AI_RED_TEAMING> ]
       ) ;
       rdf:type [ nist_ai_600_1:AiRedTeaming ]
    )
}

<AiRmfDocument> CLOSED {
    (  $<AiRmfDocument_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          schema1:version @linkml:String ? ;
          dcterms:publisher @linkml:String ? ;
          <doi> @linkml:Uriorcurie ? ;
          dcterms:issued @linkml:Date ? ;
          dcterms:source @linkml:Uriorcurie ?
       ) ;
       rdf:type [ <AiRmfDocument> ]
    )
}

<AiRmfFramework> CLOSED {
    (  $<AiRmfFramework_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <document> @<AiRmfDocument> ? ;
          <functions> @<Function> * ;
          <trustworthiness_characteristics> @<TrustworthinessCharacteristic> * ;
          <lifecycle_stages> @<AiLifecycleStage> * ;
          <dimensions> @<AiSystemDimension> * ;
          <actor_tasks> @<AiActorTask> * ;
          <profiles> @<AiRmfProfile> * ;
          <attributes> @<RmfAttribute> * ;
          <risk_measurement_challenges> @<RiskMeasurementChallenge> * ;
          <ai_specific_risks> @<AiSpecificRisk> * ;
          <human_ai_interaction_issues> @<HumanAiInteractionIssue> *
       ) ;
       rdf:type [ <AiRmfFramework> ]
    )
}

<AiRmfProfile>  (
    CLOSED {
       (  $<AiRmfProfile_tes> (  &<NamedThing_tes> ;
             rdf:type [ schema1:Thing ] ? ;
             <profile_type> [ <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#USE_CASE>
                <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#TEMPORAL_CURRENT>
                <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#TEMPORAL_TARGET>
                <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#CROSS_SECTORAL> ] ;
             <current_state> @linkml:String ? ;
             <target_state> @linkml:String ? ;
             <sector> @linkml:String ? ;
             <addresses> @<Subcategory> *
          ) ;
          rdf:type [ <AiRmfProfile> ]
       )
    } OR @nist_ai_600_1:GaiProfile
)

<AiSpecificRisk>  (
    CLOSED {
       (  $<AiSpecificRisk_tes> (  &<NamedThing_tes> ;
             rdf:type [ schema1:Thing ] ?
          ) ;
          rdf:type [ <AiSpecificRisk> ]
       )
    } OR @nist_ai_600_1:GaiRisk
)

<AiSystem> CLOSED {
    (  $<AiSystem_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <lifecycle_stage> [ <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#PLAN_AND_DESIGN>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#VERIFY_AND_VALIDATE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#DEPLOY_AND_USE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] * ;
          <ai_dimension> [ <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#APPLICATION_CONTEXT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#DATA_AND_INPUT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#AI_MODEL>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#TASK_AND_OUTPUT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#PEOPLE_AND_PLANET> ] *
       ) ;
       rdf:type [ <AiSystem> ]
    )
}

<AiSystemDimension> CLOSED {
    (  $<AiSystemDimension_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <dimension_kind> [ <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#APPLICATION_CONTEXT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#DATA_AND_INPUT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#AI_MODEL>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#TASK_AND_OUTPUT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#PEOPLE_AND_PLANET> ]
       ) ;
       rdf:type [ <AiSystemDimension> ]
    )
}

<Bias> CLOSED {
    (  $<Bias_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <bias_category> [ <https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#SYSTEMIC>
             <https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#COMPUTATIONAL_AND_STATISTICAL>
             <https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#HUMAN_COGNITIVE> ] *
       ) ;
       rdf:type [ <Bias> ]
    )
}

<Category> CLOSED {
    (  $<Category_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <category_id> @<CategoryCode> ? ;
          <outcome> @linkml:String ? ;
          <subcategories> @<Subcategory> *
       ) ;
       rdf:type [ <Category> ]
    )
}

<Function> CLOSED {
    (  $<Function_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <function_code> @<FunctionCode> ;
          <categories> @<Category> *
       ) ;
       rdf:type [ <Function> ]
    )
}

nist_ai_600_1:GaiProfile CLOSED {
    (  $nist_ai_600_1:GaiProfile_tes (  &<AiRmfProfile_tes> ;
          rdf:type [ <AiRmfProfile> ] ? ;
          nist_ai_600_1:gai_risk_catalog @nist_ai_600_1:GaiRisk * ;
          nist_ai_600_1:suggested_actions @nist_ai_600_1:SuggestedAction * ;
          nist_ai_600_1:primary_considerations @nist_ai_600_1:PrimaryGaiConsideration * ;
          nist_ai_600_1:structured_feedback_methods @nist_ai_600_1:StructuredPublicFeedback * ;
          <profile_type> [ <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#USE_CASE>
             <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#TEMPORAL_CURRENT>
             <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#TEMPORAL_TARGET>
             <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#CROSS_SECTORAL> ]
       ) ;
       rdf:type [ nist_ai_600_1:GaiProfile ]
    )
}

nist_ai_600_1:GaiRisk CLOSED {
    (  $nist_ai_600_1:GaiRisk_tes (  &<AiSpecificRisk_tes> ;
          rdf:type [ <AiSpecificRisk> ] ? ;
          nist_ai_600_1:gai_risk_kind [
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#CBRN_INFORMATION_OR_CAPABILITIES>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#CONFABULATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#DATA_PRIVACY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#ENVIRONMENTAL_IMPACTS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#HARMFUL_BIAS_OR_HOMOGENIZATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#HUMAN_AI_CONFIGURATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INFORMATION_INTEGRITY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INFORMATION_SECURITY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INTELLECTUAL_PROPERTY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#OBSCENE_DEGRADING_OR_ABUSIVE_CONTENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#VALUE_CHAIN_AND_COMPONENT_INTEGRATION> ] ? ;
          nist_ai_600_1:risk_categorization [
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#TECHNICAL_OR_MODEL_RISKS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#MISUSE_BY_HUMANS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategorizationEnum#ECOSYSTEM_OR_SOCIETAL_RISKS> ] ? ;
          nist_ai_600_1:risk_scope [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#MODEL_OR_SYSTEM>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#APPLICATION_OR_IMPLEMENTATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskScopeEnum#ECOSYSTEM> ] * ;
          nist_ai_600_1:risk_sources [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#DESIGN>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#TRAINING>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#OPERATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#MODEL_INPUTS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#MODEL_OUTPUTS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#HUMAN_BEHAVIOR>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskSourceEnum#HUMAN_AI_INTERACTION> ] * ;
          nist_ai_600_1:time_scale [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum#IMMEDIATE>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskTimeScaleEnum#PROLONGED> ] * ;
          <lifecycle_stage> [ <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#PLAN_AND_DESIGN>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#VERIFY_AND_VALIDATE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#DEPLOY_AND_USE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] * ;
          <trustworthiness_characteristic> [
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SAFE>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> ] * ;
          nist_ai_600_1:addressed_by_actions @nist_ai_600_1:SuggestedAction *
       ) ;
       rdf:type [ nist_ai_600_1:GaiRisk ]
    )
}

<Harm> CLOSED {
    (  $<Harm_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <harm_category> [ <https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_PEOPLE>
             <https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_AN_ORGANIZATION>
             <https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_AN_ECOSYSTEM> ] ? ;
          <harm_to_people_subcategory> [ <https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#INDIVIDUAL>
             <https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#GROUP_OR_COMMUNITY>
             <https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#SOCIETAL> ] ? ;
          <magnitude> @linkml:String ? ;
          <affects> @<NamedThing> *
       ) ;
       rdf:type [ <Harm> ]
    )
}

<HumanAiInteractionIssue> CLOSED {
    (  $<HumanAiInteractionIssue_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ?
       ) ;
       rdf:type [ <HumanAiInteractionIssue> ]
    )
}

<Impact> CLOSED {
    (  $<Impact_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <impact_sign> [ <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#POSITIVE>
             <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#NEGATIVE>
             <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#MIXED> ] ? ;
          <magnitude> @linkml:String ? ;
          <likelihood> @linkml:Float ? ;
          <affects> @<NamedThing> *
       ) ;
       rdf:type [ <Impact> ]
    )
}

<NamedThing>  (
    @<AiActor> OR @<AiActorTask> OR @<AiLifecycleStage> OR @<AiRmfDocument> OR @<AiRmfFramework> OR @<AiRmfProfile> OR
    @<AiSpecificRisk> OR @<AiSystem> OR @<AiSystemDimension> OR @<Bias> OR @<Category> OR @<Function> OR @<Harm> OR
    @<HumanAiInteractionIssue> OR @<Impact> OR @nist_ai_600_1:PrimaryGaiConsideration OR @<Risk> OR @<RiskMeasurementChallenge> OR
    @<RiskTolerance> OR @<RmfAttribute> OR @nist_ai_600_1:StructuredPublicFeedback OR @<Subcategory> OR
    @nist_ai_600_1:SuggestedAction OR @<TrustworthinessCharacteristic>
)

<NamedThing_struct> {
    (  $<NamedThing_tes> (  rdfs:label @linkml:String ? ;
          dcterms:title @linkml:String ? ;
          dcterms:description @linkml:String ? ;
          rdfs:seeAlso @linkml:Uriorcurie *
       ) ;
       rdf:type [ schema1:Thing ]
    )
}

<PlaybookCollection> CLOSED {
    (  $<PlaybookCollection_tes> <entries> @<PlaybookEntry> * ;
       rdf:type [ <PlaybookCollection> ] ?
    )
}

<PlaybookEntry> CLOSED {
    (  $<PlaybookEntry_tes> (  <type> @linkml:String ? ;
          <title> @linkml:String ? ;
          <category> @linkml:String ? ;
          <description> @linkml:String ? ;
          <section_about> @linkml:String ? ;
          <section_actions> @linkml:String ? ;
          <section_doc> @linkml:String ? ;
          <section_ref> @linkml:String ? ;
          <ai_actors> @linkml:String * ;
          <topic> @linkml:String *
       ) ;
       rdf:type [ <PlaybookEntry> ] ?
    )
}

nist_ai_600_1:PrimaryGaiConsideration CLOSED {
    (  $nist_ai_600_1:PrimaryGaiConsideration_tes (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_600_1:consideration_kind [ <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#GOVERNANCE>
             <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#PRE_DEPLOYMENT_TESTING>
             <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#CONTENT_PROVENANCE>
             <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsiderationEnum#INCIDENT_DISCLOSURE> ] ;
          nist_ai_600_1:governance_practices @linkml:String * ;
          nist_ai_600_1:third_party_considerations @linkml:String ? ;
          nist_ai_600_1:limitations_of_current_approaches @linkml:String ? ;
          nist_ai_600_1:provenance_techniques @linkml:String * ;
          nist_ai_600_1:ai_incident_definition @linkml:String ?
       ) ;
       rdf:type [ nist_ai_600_1:PrimaryGaiConsideration ]
    )
}

<ResidualRisk> CLOSED {
    (  $<ResidualRisk_tes> (  &<Risk_tes> ;
          rdf:type [ <Risk> ] ? ;
          <is_residual> @linkml:Boolean ?
       ) ;
       rdf:type [ <ResidualRisk> ]
    )
}

<Risk>  (
    CLOSED {
       (  $<Risk_tes> (  &<NamedThing_tes> ;
             rdf:type [ schema1:Thing ] ? ;
             <likelihood> @linkml:Float ? ;
             <magnitude> @linkml:String ? ;
             <impact_sign> [ <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#POSITIVE>
                <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#NEGATIVE>
                <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#MIXED> ] ? ;
             <is_residual> @linkml:Boolean ? ;
             <risk_response> [ <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#MITIGATING>
                <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#TRANSFERRING>
                <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#AVOIDING>
                <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#ACCEPTING> ] ? ;
             <lifecycle_stage> [ <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#PLAN_AND_DESIGN>
                <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>
                <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>
                <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#VERIFY_AND_VALIDATE>
                <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#DEPLOY_AND_USE>
                <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] * ;
             <trustworthiness_characteristic> [
                <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE>
                <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SAFE>
                <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT>
                <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT>
                <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE>
                <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED>
                <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> ] * ;
             <related_impacts> @<Impact> * ;
             <affects_system> @<AiSystem> ?
          ) ;
          rdf:type [ <Risk> ]
       )
    } OR @<ResidualRisk>
)

<RiskMeasurementChallenge> CLOSED {
    (  $<RiskMeasurementChallenge_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <challenge_kind> [
             <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#THIRD_PARTY_SOFTWARE_HARDWARE_AND_DATA>
             <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#TRACKING_EMERGENT_RISKS>
             <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#AVAILABILITY_OF_RELIABLE_METRICS>
             <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#RISK_AT_DIFFERENT_LIFECYCLE_STAGES>
             <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#RISK_IN_REAL_WORLD_SETTINGS>
             <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#INSCRUTABILITY>
             <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#HUMAN_BASELINE> ]
       ) ;
       rdf:type [ <RiskMeasurementChallenge> ]
    )
}

<RiskTolerance> CLOSED {
    (  $<RiskTolerance_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <tolerance_statement> @linkml:String ? ;
          <legal_basis> @linkml:String ?
       ) ;
       rdf:type [ <RiskTolerance> ]
    )
}

<RmfAttribute> CLOSED {
    (  $<RmfAttribute_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ?
       ) ;
       rdf:type [ <RmfAttribute> ]
    )
}

nist_ai_600_1:StructuredPublicFeedback  (
    CLOSED {
       (  $nist_ai_600_1:StructuredPublicFeedback_tes (  &<NamedThing_tes> ;
             rdf:type [ schema1:Thing ] ? ;
             nist_ai_600_1:feedback_method_kind [
                <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#PARTICIPATORY_ENGAGEMENT_METHODS>
                <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#FIELD_TESTING>
                <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedbackMethodEnum#AI_RED_TEAMING> ]
          ) ;
          rdf:type [ nist_ai_600_1:StructuredPublicFeedback ]
       )
    } OR @nist_ai_600_1:AiRedTeaming
)

<Subcategory> CLOSED {
    (  $<Subcategory_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <subcategory_id> @<SubcategoryCode> ? ;
          <outcome> @linkml:String ? ;
          <trustworthiness_characteristic> [
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SAFE>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> ] * ;
          <lifecycle_stage> [ <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#PLAN_AND_DESIGN>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#VERIFY_AND_VALIDATE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#DEPLOY_AND_USE>
             <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ] * ;
          <about_text> @linkml:String ? ;
          <suggested_actions_text> @linkml:String ? ;
          <documentation_questions> @linkml:String ? ;
          <references_text> @linkml:String ? ;
          <topics> @linkml:String * ;
          <ai_actor_categories> @linkml:String *
       ) ;
       rdf:type [ <Subcategory> ]
    )
}

nist_ai_600_1:SuggestedAction CLOSED {
    (  $nist_ai_600_1:SuggestedAction_tes (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          nist_ai_600_1:action_id @nist_ai_600_1:GaiActionId ;
          nist_ai_600_1:function_prefix [ <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#GV>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MP>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiActionFunctionPrefixEnum#MG> ] ? ;
          nist_ai_600_1:applies_to_subcategory @<SubcategoryCode> ? ;
          nist_ai_600_1:gai_risks [ <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#CBRN_INFORMATION_OR_CAPABILITIES>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#CONFABULATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#DATA_PRIVACY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#ENVIRONMENTAL_IMPACTS>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#HARMFUL_BIAS_OR_HOMOGENIZATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#HUMAN_AI_CONFIGURATION>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INFORMATION_INTEGRITY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INFORMATION_SECURITY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#INTELLECTUAL_PROPERTY>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#OBSCENE_DEGRADING_OR_ABUSIVE_CONTENT>
             <https://w3id.org/lmodel/nist-ai-600-1/GaiRiskCategoryEnum#VALUE_CHAIN_AND_COMPONENT_INTEGRATION> ] * ;
          <actor_task> [ <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DESIGN>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEVELOPMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEPLOYMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OPERATION_AND_MONITORING>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#TEVV>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#HUMAN_FACTORS>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#DOMAIN_EXPERT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_IMPACT_ASSESSMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#PROCUREMENT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GOVERNANCE_AND_OVERSIGHT>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#THIRD_PARTY_ENTITIES>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#END_USERS>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AFFECTED_INDIVIDUALS_OR_COMMUNITIES>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OTHER_AI_ACTORS>
             <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GENERAL_PUBLIC> ] * ;
          dcterms:description @linkml:String ?
       ) ;
       rdf:type [ nist_ai_600_1:SuggestedAction ]
    )
}

<TrustworthinessCharacteristic> CLOSED {
    (  $<TrustworthinessCharacteristic_tes> (  &<NamedThing_tes> ;
          rdf:type [ schema1:Thing ] ? ;
          <characteristic_kind> [ <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SAFE>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED>
             <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> ] ;
          <is_base_condition> @linkml:Boolean ? ;
          <is_cross_cutting> @linkml:Boolean ?
       ) ;
       rdf:type [ <TrustworthinessCharacteristic> ]
    )
}
