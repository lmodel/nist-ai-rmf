	rdfs:label "gai_incident_harms" ;
	skos:definition "The kinds of harm that section A.1.8's definition of an AI incident names." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_primary_considerations> a owl:ObjectProperty ;
	rdfs:label "gai_primary_considerations" ;
	skos:definition "The four primary considerations of Appendix A." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_provenance_techniques> a owl:ObjectProperty ;
	rdfs:label "gai_provenance_techniques" ;
	skos:definition "The well-known techniques for provenance data tracking that section A.1.6 names." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_red_teaming_types> a owl:ObjectProperty ;
	rdfs:label "gai_red_teaming_types" ;
	skos:definition "The kinds of AI red-teaming that may suit the use case." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_risk_characteristics> a owl:ObjectProperty ;
	rdfs:label "gai_risk_characteristics" ;
	skos:definition "The AI RMF's trustworthiness characteristics that the subsection names for the risk." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_risks> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_risk_groupings> a owl:ObjectProperty ;
	rdfs:label "gai_risk_groupings" ;
	skos:definition "The groups footnote 5 suggests for the risk. The footnote lists Data Privacy under all three." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_risks> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_risk_lifecycle_stages> a owl:ObjectProperty ;
	rdfs:label "gai_risk_lifecycle_stages" ;
	skos:definition "The lifecycle stages where the risk can arise for the adopter's model, system or use case." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_risks> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_risk_name> a owl:ObjectProperty ;
	rdfs:label "gai_risk_name" ;
	skos:definition "Which of the 12 risks this is." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_risks> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_risk_scopes> a owl:ObjectProperty ;
	rdfs:label "gai_risk_scopes" ;
	skos:definition "The levels where the risk exists for the adopter's model, system or use case." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_risks> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_risk_section> a owl:DatatypeProperty ;
	rdfs:label "gai_risk_section" ;
	skos:definition "The subsection of section 2 that discusses the risk, such as 2.1." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_risks> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_risk_sources> a owl:ObjectProperty ;
	rdfs:label "gai_risk_sources" ;
	skos:definition "Where the risk comes from for the adopter's model, system or use case." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_risks> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_risk_time_scales> a owl:ObjectProperty ;
	rdfs:label "gai_risk_time_scales" ;
	skos:definition "How the risk materializes over time for the adopter's model, system or use case." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_risks> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_risks> a owl:ObjectProperty ;
	rdfs:label "gai_risks" ;
	skos:definition "The 12 risks of section 2." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_structured_feedback> a owl:ObjectProperty ;
	rdfs:label "gai_structured_feedback" ;
	skos:definition "The kinds of structured public feedback section A.1.5 gives as examples." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_subcategories> a owl:ObjectProperty ;
	rdfs:label "gai_subcategories" ;
	skos:definition "The tables of section 3, in the publication's order." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_subcategory_actions> a owl:ObjectProperty ;
	rdfs:label "gai_subcategory_actions" ;
	skos:definition "The suggested actions the table lists." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_actions> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_subcategory_actor_tasks> a owl:ObjectProperty ;
	rdfs:label "gai_subcategory_actor_tasks" ;
	skos:definition "The AI actor tasks the table names. They belong to the table and not to one action: the publication says not every task applies to every action." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_actions> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_third_party_controls> a owl:ObjectProperty ;
	rdfs:label "gai_third_party_controls" ;
	skos:definition "The existing controls that section A.1.3 says can apply to third-party GAI." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-rmf.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://www.nist.gov/itl/ai-risk-management-framework> ;
	dcterms:title "NIST AI Risk Management Framework family" ;
	pav:version "1.0.0" ;
	a owl:Ontology ;
	rdfs:label "nist_ai_rmf" ;
	rdfs:seeAlso <https://lmodel.github.io/nist-ai-rmf> , <https://w3id.org/lmodel/nist-ai-100-1> , <https://w3id.org/lmodel/nist-ai-600-1> ;
	skos:definition "One LinkML schema for two NIST publications: the AI Risk Management Framework 1.0 (NIST AI 100-1) and its Generative AI Profile (NIST AI 600-1)." ;
	skos:note "Every module of lmodel/nist-ai-100-1 and lmodel/nist-ai-600-1 is vendored in this folder as released, so the schema needs no network, and tests/test_upstream.py holds them to their hashes. Each element keeps the IRI of its publication, and this schema adds only the class below." , "The AI RMF to ISO/IEC 42001 crosswalk pairs records, not schema elements, so it is no mapping of this schema. scripts/build_crosswalk.py writes it as SSSOM under tmp/, and the repository carries neither it nor its PDF, which states no licence." , "The version is the 1.0.0 both publications carry, and source is NIST's page for the framework. The release tags are the schema's own versions." .
nist_ai_rmf:AiRmfActorTaskName\#affected_individuals_and_communities dcterms:title "Affected individuals/communities" ;
	a owl:Class ;
	rdfs:label "affected_individuals_and_communities" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:altLabel "Affected Individuals and Communities" ;
	skos:definition "Those directly or indirectly affected by the system or its output, whether or not they interact with it." .
nist_ai_rmf:AiRmfActorTaskName\#ai_deployment dcterms:title "AI Deployment" ;
	a owl:Class ;
	rdfs:label "ai_deployment" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:definition "Deciding how the system is used and putting it into production, including pilots and compliance checks." .
nist_ai_rmf:AiRmfActorTaskName\#ai_design dcterms:title "AI Design" ;
	a owl:Class ;
	rdfs:label "ai_design" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:definition "Setting what the system is for, planning and designing it, and gathering and preparing its data." .
nist_ai_rmf:AiRmfActorTaskName\#ai_development dcterms:title "AI Development" ;
	a owl:Class ;
	rdfs:label "ai_development" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:definition "Providing the initial infrastructure, and creating, selecting, calibrating, training and testing models." .
nist_ai_rmf:AiRmfActorTaskName\#ai_impact_assessment dcterms:title "AI Impact Assessment" ;
	a owl:Class ;
	rdfs:label "ai_impact_assessment" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:definition "Assessing accountability, harmful bias, impacts, product safety, liability and security." .
nist_ai_rmf:AiRmfActorTaskName\#domain_expert dcterms:title "Domain Expert" ;
	a owl:Class ;
	rdfs:label "domain_expert" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:altLabel "Domain Experts" ;
	skos:definition "Giving knowledge of the sector or setting where the system is used." .
nist_ai_rmf:AiRmfActorTaskName\#end_users dcterms:title "End users" ;
	a owl:Class ;
	rdfs:label "end_users" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:altLabel "End Users" , "End-Users" ;
	skos:definition "The people or groups who use the system, whether new to technology or expert in AI." .
nist_ai_rmf:AiRmfActorTaskName\#general_public dcterms:title "General public" ;
	a owl:Class ;
	rdfs:label "general_public" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:definition "Those most likely to experience the impacts directly, who may motivate what other AI actors do." .
nist_ai_rmf:AiRmfActorTaskName\#governance_and_oversight dcterms:title "Governance and Oversight" ;
	a owl:Class ;
	rdfs:label "governance_and_oversight" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:definition "Holding management, fiduciary and legal authority for the organization where the system is designed, developed or deployed." .
nist_ai_rmf:AiRmfActorTaskName\#human_factors dcterms:title "Human Factors" ;
	a owl:Class ;
	rdfs:label "human_factors" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:definition "Human-centered design and evaluation, involving end users and bringing context-specific norms and values into design." .
nist_ai_rmf:AiRmfActorTaskName\#operation_and_monitoring dcterms:title "Operation and Monitoring" ;
	a owl:Class ;
	rdfs:label "operation_and_monitoring" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:definition "Running the system and regularly assessing its output and impacts." .
nist_ai_rmf:AiRmfActorTaskName\#other_ai_actors dcterms:title "Other AI actors" ;
	a owl:Class ;
	rdfs:label "other_ai_actors" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:definition "Those who may provide norms or guidance on AI risk, such as standards bodies, advocacy groups and researchers." .
nist_ai_rmf:AiRmfActorTaskName\#procurement dcterms:title "Procurement" ;
	a owl:Class ;
	rdfs:label "procurement" ;
	rdfs:subClassOf nist_ai_rmf:AiRmfActorTaskName ;
	skos:definition "Acquiring AI from another party, under financial, legal or policy authority." .
