	rdfs:label "title" ;
	skos:definition "The element's name." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_base> ;
	skos:note "It carries the IRI of LOKF's title, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." .
<https://w3id.org/lmodel/nist-ai-600-1/GaiAiRedTeaming> a owl:Class ;
	rdfs:label "GaiAiRedTeaming" ;
	rdfs:subClassOf <https://w3id.org/lmodel/nist-ai-600-1/GaiStructuredFeedback> , _:c14n316 , _:c14n371 ;
	skos:definition "A structured exercise that probes an AI system for flaws and vulnerabilities, often with its developers." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/AiRedTeaming> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/GaiContentProvenanceConsideration> a owl:Class ;
	rdfs:label "GaiContentProvenanceConsideration" ;
	rdfs:subClassOf <https://w3id.org/lmodel/nist-ai-600-1/GaiPrimaryConsideration> , _:c14n117 , _:c14n523 ;
	skos:definition "How tracking the origin and history of content helps tell authentic content from synthetic content." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/ContentProvenanceConsideration> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/GaiFieldTesting> a owl:Class ;
	rdfs:label "GaiFieldTesting" ;
	rdfs:subClassOf <https://w3id.org/lmodel/nist-ai-600-1/GaiStructuredFeedback> ;
	skos:definition "Structured settings that show how people interact with and use AI-generated information." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/FieldTesting> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/GaiGovernanceConsideration> a owl:Class ;
	rdfs:label "GaiGovernanceConsideration" ;
	rdfs:subClassOf <https://w3id.org/lmodel/nist-ai-600-1/GaiPrimaryConsideration> , _:c14n26 , _:c14n294 , _:c14n324 , _:c14n9 ;
	skos:definition "How an organization's governance can be revisited for GAI, including across the AI value chain." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/GovernanceConsideration> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/GaiIncidentDisclosureConsideration> a owl:Class ;
	rdfs:label "GaiIncidentDisclosureConsideration" ;
	rdfs:subClassOf <https://w3id.org/lmodel/nist-ai-600-1/GaiPrimaryConsideration> , _:c14n365 , _:c14n90 ;
	skos:definition "How documenting, reporting and sharing AI incidents helps prevent harm, though no formal channels exist." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/IncidentDisclosureConsideration> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/GaiParticipatoryEngagement> a owl:Class ;
	rdfs:label "GaiParticipatoryEngagement" ;
	rdfs:subClassOf <https://w3id.org/lmodel/nist-ai-600-1/GaiStructuredFeedback> ;
	skos:definition "Asking civil society groups, affected communities and users for feedback, such as through focus groups or surveys." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/ParticipatoryEngagement> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/GaiPreDeploymentTestingConsideration> a owl:Class ;
	rdfs:label "GaiPreDeploymentTestingConsideration" ;
	rdfs:subClassOf <https://w3id.org/lmodel/nist-ai-600-1/GaiPrimaryConsideration> , _:c14n11 , _:c14n481 ;
	skos:definition "How GAI can be tested before deployment while better approaches mature, and where current tests fall short." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/PreDeploymentTestingConsideration> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> ;
	skos:note "Section A.1.7 calls the feedback approaches of section A.1.5 part of this consideration." .
<https://w3id.org/lmodel/nist-ai-600-1/GaiPrimaryConsideration> a owl:Class ;
	rdfs:label "GaiPrimaryConsideration" ;
	rdfs:subClassOf _:c14n210 , _:c14n283 , _:c14n300 , _:c14n350 , _:c14n368 , _:c14n412 , _:c14n417 , _:c14n44 , _:c14n514 , _:c14n58 , _:c14n7 , _:c14n98 ;
	skos:definition "One of the four primary considerations of Appendix A, which also inform the suggested actions." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/PrimaryConsideration> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/GaiProfile> a owl:Class ;
	rdfs:label "GaiProfile" ;
	rdfs:subClassOf <https://w3id.org/lmodel/nist-ai-100-1/AiRmfProfile> , _:c14n153 , _:c14n362 , _:c14n418 , _:c14n428 , _:c14n525 , _:c14n57 ;
	skos:definition "The Generative AI Profile as a whole, a cross-sectoral profile of the AI RMF and a companion resource to it." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/Profile> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
	skos:note "It holds actions for only some subcategories, and the publication says more may be added later." .
<https://w3id.org/lmodel/nist-ai-600-1/GaiRisk> a owl:Class ;
	rdfs:label "GaiRisk" ;
	rdfs:subClassOf _:c14n112 , _:c14n148 , _:c14n154 , _:c14n185 , _:c14n197 , _:c14n203 , _:c14n254 , _:c14n292 , _:c14n299 , _:c14n307 , _:c14n359 , _:c14n37 , _:c14n415 , _:c14n451 , _:c14n469 , _:c14n472 , _:c14n484 , _:c14n491 , _:c14n50 , _:c14n519 , _:c14n94 ;
	skos:definition "A risk that section 2 defines as unique to or made worse by the development and use of GAI." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/Risk> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_risks> ;
	skos:note "The publication gives a risk its section, its definition, its trustworthiness characteristics and, in a footnote, its groupings. It assigns no lifecycle stage, scope, source or time scale to a risk, since those depend on the model, system or use case. An adopter fills them in." ;
	skos:relatedMatch <https://w3id.org/lmodel/nist-ai-100-1/Risk> .
<https://w3id.org/lmodel/nist-ai-600-1/GaiStructuredFeedback> a owl:Class ;
	rdfs:label "GaiStructuredFeedback" ;
	rdfs:subClassOf _:c14n111 , _:c14n127 , _:c14n139 , _:c14n250 , _:c14n255 , _:c14n33 , _:c14n476 , _:c14n505 , _:c14n507 , _:c14n52 ;
	skos:definition "A way of using structured public feedback to evaluate whether GAI systems perform as intended." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/StructuredFeedback> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/GaiSubcategory> a owl:Class ;
	rdfs:label "GaiSubcategory" ;
	rdfs:subClassOf _:c14n122 , _:c14n15 , _:c14n172 , _:c14n249 , _:c14n278 , _:c14n343 , _:c14n357 , _:c14n462 , _:c14n516 , _:c14n84 ;
	skos:definition "An AI RMF subcategory as one table of section 3 addresses it. The Profile covers only some of the 72." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/Subcategory> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_actions> ;
	skos:relatedMatch <https://w3id.org/lmodel/nist-ai-100-1/Subcategory> .
<https://w3id.org/lmodel/nist-ai-600-1/GaiSuggestedAction> a owl:Class ;
