	rdfs:range xsd:string ;
	skos:definition "Which of the four classes this record is." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_feedback_type> a owl:DatatypeProperty ;
	rdfs:label "gai_feedback_type" ;
	rdfs:range xsd:string ;
	skos:definition "Which of the three classes this record is." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
<https://w3id.org/lmodel/nist-ai-600-1/gai_governance_plans> a owl:ObjectProperty ;
	rdfs:label "gai_governance_plans" ;
	skos:definition "The plans and actions that section A.1.2 lists from other AI governance." ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_considerations> .
