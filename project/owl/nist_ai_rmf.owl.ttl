@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix nist_ai_600_1: <https://w3id.org/lmodel/nist-ai-600-1/> .
@prefix nist_ai_rmf: <https://w3id.org/lmodel/nist-ai-rmf/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nist_ai_600_1:AiRedTeaming a owl:Class ;
    rdfs:label "AiRedTeaming" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:RedTeamingTypeEnum ;
            owl:onProperty nist_ai_600_1:red_team_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:red_team_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:feedback_method_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:feedback_method_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:feedback_method_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:red_team_type ],
        nist_ai_600_1:StructuredPublicFeedback ;
    skos:definition """A structured testing exercise used to probe an AI system to
find flaws and vulnerabilities such as inaccurate, harmful, or
discriminatory outputs, often in a controlled environment and
in collaboration with system developers (A.1.5).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/stix/AttackPattern> .

nist_ai_600_1:GaiProfile a owl:Class ;
    rdfs:label "GaiProfile" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:primary_considerations ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:PrimaryGaiConsideration ;
            owl:onProperty nist_ai_600_1:primary_considerations ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:profile_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:profile_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:GaiRisk ;
            owl:onProperty nist_ai_600_1:gai_risk_catalog ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:structured_feedback_methods ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:SuggestedAction ;
            owl:onProperty nist_ai_600_1:suggested_actions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:profile_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:StructuredPublicFeedback ;
            owl:onProperty nist_ai_600_1:structured_feedback_methods ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:gai_risk_catalog ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:suggested_actions ],
        nist_ai_rmf:AiRmfProfile ;
    skos:closeMatch <https://w3id.org/lmodel/nist-csf-v2/CSFDocument> ;
    skos:definition """Root container that bundles the NIST AI 600-1 Generative AI
Profile: GAI risks (Section 2), suggested actions (Section 3),
and primary considerations (Appendix A).""" ;
    skos:exactMatch <https://w3id.org/lmodel/oscal_profile/Profile> ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

<https://w3id.org/lmodel/nist-ai-rmf.owl.ttl> a owl:Ontology ;
    rdfs:label "nist-ai-rmf" ;
    dcterms:license "Apache-2.0" ;
    dcterms:title "NIST AI Risk Management Framework" ;
    pav:version "1.0.0" ;
    rdfs:seeAlso <https://doi.org/10.6028/NIST.AI.100-1>,
        <https://doi.org/10.6028/NIST.AI.600-1>,
        <https://w3id.org/lmodel/nist-ai-100-1>,
        <https://w3id.org/lmodel/nist-ai-600-1>,
        <https://www.nist.gov/itl/ai-risk-management-framework> ;
    skos:definition """Umbrella LinkML schema for the NIST AI Risk Management Framework
family.

Imports:
  * `nist_ai_100_1` - AI RMF 1.0 (NIST AI 100-1) foundational
    concepts, Core Functions / Categories / Subcategories,
    Profiles, design attributes, and the AI RMF Playbook
    companion data shape.
  * `nist_ai_600_1` - GAI Profile (NIST AI 600-1): 12 GAI
    risks, Suggested Actions, Primary GAI Considerations, and
    Structured Public Feedback methods.

Most consumers should import this umbrella to get the entire
framework via a single namespace (`nist_ai_rmf:`). Two tree-root
classes are exposed by the imports - `AiRmfFramework` from the
core module and `GaiProfile` from the GAI module - so callers
must pass `--target-class` when validating.""" .

nist_ai_rmf:PlaybookCollection a owl:Class ;
    rdfs:label "PlaybookCollection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:PlaybookEntry ;
            owl:onProperty nist_ai_rmf:entries ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:entries ] ;
    skos:definition """A container for a set of PlaybookEntry instances - the
serialisation root for an AI RMF Playbook companion document.
Validate with ``linkml-validate --target-class PlaybookCollection``;
the canonical tree-root for the schema is ``AiRmfFramework``.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:ResidualRisk a owl:Class ;
    rdfs:label "ResidualRisk" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:is_residual ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:is_residual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:is_residual ],
        nist_ai_rmf:Risk ;
    skos:definition """Risk remaining after risk treatment (ISO Guide 73). Documenting
residual risks helps system providers consider risks of deploying
the AI product and informs end users about potential negative
impacts.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    skos:narrowMatch <https://w3id.org/lmodel/iso27001/Risk> .

nist_ai_rmf:category_code a owl:DatatypeProperty ;
    rdfs:label "category_code" ;
    rdfs:range xsd:string ;
    skos:definition """Compact category code in the form "FUNCTION-N" (e.g.,
"GOVERN-1") as used in the AI RMF Playbook.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:function_kind a owl:ObjectProperty ;
    rdfs:label "function_kind" ;
    rdfs:range nist_ai_rmf:FunctionEnum ;
    skos:definition "The AI RMF Core function this entry pertains to." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_600_1:GaiRisk a owl:Class ;
    rdfs:label "GaiRisk" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:GaiRiskScopeEnum ;
            owl:onProperty nist_ai_600_1:risk_scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_600_1:SuggestedAction ;
            owl:onProperty nist_ai_600_1:addressed_by_actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:GaiRiskCategoryEnum ;
            owl:onProperty nist_ai_600_1:gai_risk_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:risk_categorization ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiLifecycleStageEnum ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:trustworthiness_characteristic ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:addressed_by_actions ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:TrustworthinessCharacteristicEnum ;
            owl:onProperty nist_ai_rmf:trustworthiness_characteristic ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:GaiRiskCategorizationEnum ;
            owl:onProperty nist_ai_600_1:risk_categorization ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:GaiRiskTimeScaleEnum ;
            owl:onProperty nist_ai_600_1:time_scale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:gai_risk_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:GaiRiskSourceEnum ;
            owl:onProperty nist_ai_600_1:risk_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:risk_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:risk_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:risk_categorization ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:time_scale ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:gai_risk_kind ],
        nist_ai_rmf:AiSpecificRisk ;
    skos:broadMatch <https://w3id.org/lmodel/iso27001/Risk> ;
    skos:closeMatch nist_ai_rmf:AiSpecificRisk ;
    skos:definition """A risk that is novel to or exacerbated by Generative AI.
Each instance corresponds to one of the 12 risk categories
enumerated in NIST AI 600-1 Section 2.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/iso29100/PrivacyRisk> .

nist_ai_rmf:AiActor a owl:Class ;
    rdfs:label "AiActor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:is_tevv ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:audience ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiActorTaskEnum ;
            owl:onProperty nist_ai_rmf:actor_task ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty nist_ai_rmf:is_tevv ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AudienceEnum ;
            owl:onProperty nist_ai_rmf:audience ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiLifecycleStageEnum ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:actor_task ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:audience ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:is_tevv ],
        nist_ai_rmf:NamedThing ;
    skos:closeMatch prov:Agent,
        foaf:Agent ;
    skos:definition """An organization or individual that plays an active role in the AI
system lifecycle. AI actors include those who deploy or operate
AI as well as those who inform via formal or quasi-formal norms
and guidance (OECD 2019).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/iso27001/InterestedParty>,
        <https://w3id.org/lmodel/stix/Identity> .

nist_ai_rmf:AiRmfFramework a owl:Class ;
    rdfs:label "AiRmfFramework" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:ai_specific_risks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:dimensions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:actor_tasks ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiActorTask ;
            owl:onProperty nist_ai_rmf:actor_tasks ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:RmfAttribute ;
            owl:onProperty nist_ai_rmf:attributes_ ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiLifecycleStage ;
            owl:onProperty nist_ai_rmf:lifecycle_stages ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:profiles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:document ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiSystemDimension ;
            owl:onProperty nist_ai_rmf:dimensions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:lifecycle_stages ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiRmfDocument ;
            owl:onProperty nist_ai_rmf:document ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:attributes_ ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:Function ;
            owl:onProperty nist_ai_rmf:functions ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiRmfProfile ;
            owl:onProperty nist_ai_rmf:profiles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:human_ai_interaction_issues ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:trustworthiness_characteristics ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiSpecificRisk ;
            owl:onProperty nist_ai_rmf:ai_specific_risks ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:TrustworthinessCharacteristic ;
            owl:onProperty nist_ai_rmf:trustworthiness_characteristics ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:document ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:risk_measurement_challenges ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:HumanAiInteractionIssue ;
            owl:onProperty nist_ai_rmf:human_ai_interaction_issues ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:RiskMeasurementChallenge ;
            owl:onProperty nist_ai_rmf:risk_measurement_challenges ],
        nist_ai_rmf:NamedThing ;
    skos:closeMatch <https://w3id.org/lmodel/nist-csf-v2/CSFDocument>,
        <https://w3id.org/lmodel/nist-sp-800-53/Catalog>,
        <https://w3id.org/lmodel/oscal_catalog/Catalog> ;
    skos:definition """Root container that bundles the AI RMF Core (Functions) with
foundational concepts (trustworthiness characteristics,
lifecycle, actors, risks, harms), profiles, and Framework
attributes. Designed for serialising the Framework or a tailored
instance of it as a single JSON / YAML document.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:Bias a owl:Class ;
    rdfs:label "Bias" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:BiasCategoryEnum ;
            owl:onProperty nist_ai_rmf:bias_category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:bias_category ],
        nist_ai_rmf:NamedThing ;
    skos:definition """A form of AI bias - a deviation that may be perpetuated or
amplified by AI systems. NIST identifies three major categories:
systemic, computational/statistical, and human-cognitive
(Part 1 §3.7; NIST SP 1270).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/iso29100/PrivacyPrinciple> .

nist_ai_rmf:Harm a owl:Class ;
    rdfs:label "Harm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:NamedThing ;
            owl:onProperty nist_ai_rmf:affects ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:HarmCategoryEnum ;
            owl:onProperty nist_ai_rmf:harm_category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:magnitude ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:harm_category ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:magnitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:HarmToPeopleSubcategoryEnum ;
            owl:onProperty nist_ai_rmf:harm_to_people_subcategory ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:magnitude ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:harm_to_people_subcategory ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:affects ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:harm_to_people_subcategory ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:harm_category ],
        nist_ai_rmf:NamedThing ;
    skos:definition """A negative impact that may be experienced by individuals,
groups, communities, organizations, society, the environment, or
the planet (Figure 1).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:PlaybookEntry a owl:Class ;
    rdfs:label "PlaybookEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:section_about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:section_actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:section_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:section_about ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:section_actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:section_doc ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:section_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:section_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:ai_actors ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:topic ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:section_actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:section_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:section_doc ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:ai_actors ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:section_doc ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:type ] ;
    skos:closeMatch <https://w3id.org/lmodel/nist-csf-v2/CSFSubcategory> ;
    skos:definition """A single AI RMF Playbook entry - an enrichment of a Core
subcategory with prose discussion, suggested actions,
documentation questions, references, and topic tags.

Attribute names use the same identifiers found in the published
NIST AI RMF Playbook JSON (e.g., `section_about`,
`section_actions`) so that the data can be loaded directly.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:RiskTolerance a owl:Class ;
    rdfs:label "RiskTolerance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:tolerance_statement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:legal_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:legal_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:tolerance_statement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:legal_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:tolerance_statement ],
        nist_ai_rmf:NamedThing ;
    skos:closeMatch <https://w3id.org/lmodel/iso27001/RiskLevel> ;
    skos:definition """The organization's or AI actor's readiness to bear risk in order
to achieve its objectives (Adapted from ISO Guide 73). Risk
tolerance is highly contextual and application- and use-case
specific.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_600_1:PrimaryGaiConsideration a owl:Class ;
    rdfs:label "PrimaryGaiConsideration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:PrimaryConsiderationEnum ;
            owl:onProperty nist_ai_600_1:consideration_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:governance_practices ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:provenance_techniques ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:limitations_of_current_approaches ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:ai_incident_definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:third_party_considerations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:consideration_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:third_party_considerations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:third_party_considerations ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:provenance_techniques ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:ai_incident_definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:ai_incident_definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:limitations_of_current_approaches ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_600_1:consideration_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:limitations_of_current_approaches ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:governance_practices ],
        nist_ai_rmf:NamedThing ;
    skos:definition """An overarching consideration derived from the NIST GAI PWG
consultation process (Appendix A). The `consideration_kind`
attribute discriminates between the four primary
considerations: Governance, Pre-Deployment Testing, Content
Provenance, and Incident Disclosure.

All consideration-specific attributes are optional and apply
to the appropriate `consideration_kind`:
  * GOVERNANCE: governance_practices, third_party_considerations
  * PRE_DEPLOYMENT_TESTING: limitations_of_current_approaches
  * CONTENT_PROVENANCE: provenance_techniques
  * INCIDENT_DISCLOSURE: ai_incident_definition""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/nist-csf-v2/CSFProperty> .

nist_ai_600_1:addressed_by_actions a owl:ObjectProperty ;
    rdfs:label "addressed_by_actions" ;
    skos:definition "Suggested actions that address this risk (back-reference)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:gai_risk_catalog a owl:ObjectProperty ;
    rdfs:label "gai_risk_catalog" ;
    skos:definition "The catalog of GAI risks (Section 2)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:gai_risks a owl:ObjectProperty ;
    rdfs:label "gai_risks" ;
    rdfs:range nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """GAI risk categories addressed by a suggested action or
considered by a primary consideration.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:governance_practices a owl:DatatypeProperty ;
    rdfs:label "governance_practices" ;
    skos:definition """Governance plans and actions (A.1.2) - e.g., "Auditing and
assessment", "Data provenance", "Incident response",
"Impact assessments", "Stakeholder engagement", "Synthetic
content detection", "Whistleblower protections".""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:primary_considerations a owl:ObjectProperty ;
    rdfs:label "primary_considerations" ;
    skos:definition """The primary GAI considerations from Appendix A
(Governance, Pre-Deployment Testing, Content Provenance,
Incident Disclosure). Discriminated by
`consideration_kind`.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:provenance_techniques a owl:DatatypeProperty ;
    rdfs:label "provenance_techniques" ;
    skos:definition """For Content Provenance: provenance data tracking
techniques such as digital watermarking, metadata
recording, digital fingerprinting, human authentication
(A.1.6).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:risk_scope a owl:ObjectProperty ;
    rdfs:label "risk_scope" ;
    rdfs:range nist_ai_rmf:GaiRiskScopeEnum ;
    skos:definition "Scope levels at which the risk may manifest." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:risk_sources a owl:ObjectProperty ;
    rdfs:label "risk_sources" ;
    rdfs:range nist_ai_rmf:GaiRiskSourceEnum ;
    skos:definition "Sources from which the risk may emerge." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:structured_feedback_methods a owl:ObjectProperty ;
    rdfs:label "structured_feedback_methods" ;
    skos:definition """Structured public feedback methods relevant to the profile
(A.1.5).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:suggested_actions a owl:ObjectProperty ;
    rdfs:label "suggested_actions" ;
    skos:definition "Suggested actions to manage GAI risks (Section 3)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:time_scale a owl:ObjectProperty ;
    rdfs:label "time_scale" ;
    rdfs:range nist_ai_rmf:GaiRiskTimeScaleEnum ;
    skos:definition "Time scales over which the risk may materialise." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_rmf:AiActorTask a owl:Class ;
    rdfs:label "AiActorTask" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:task_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:typical_actors ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiSystemDimensionEnum ;
            owl:onProperty nist_ai_rmf:ai_dimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiActorTaskEnum ;
            owl:onProperty nist_ai_rmf:task_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiLifecycleStageEnum ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:ai_dimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:typical_actors ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:task_kind ],
        nist_ai_rmf:NamedThing ;
    skos:definition """A category of task performed by AI actors (Appendix A). Each
task is associated with one or more lifecycle stages and a
typical set of actor roles.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AFFECTED_INDIVIDUALS_OR_COMMUNITIES> a owl:Class ;
    rdfs:label "AFFECTED_INDIVIDUALS_OR_COMMUNITIES" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """All individuals, groups, communities, or organizations directly
or indirectly affected by AI systems or decisions based on the
output of AI systems.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEPLOYMENT> a owl:Class ;
    rdfs:label "AI_DEPLOYMENT" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Performed during the Task and Output phase; responsible for
contextual decisions on how the AI system is used and for
assuring deployment into production.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DESIGN> a owl:Class ;
    rdfs:label "AI_DESIGN" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Performed during the Application Context and Data and Input
phases; create the concept and objectives of AI systems and are
responsible for planning, design, and data collection.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEVELOPMENT> a owl:Class ;
    rdfs:label "AI_DEVELOPMENT" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Performed during the AI Model phase; provide the initial
infrastructure of AI systems (model building, selection,
calibration, training, testing).""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_IMPACT_ASSESSMENT> a owl:Class ;
    rdfs:label "AI_IMPACT_ASSESSMENT" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Assess and evaluate requirements for AI system accountability,
combat harmful bias, examine impacts, product safety, liability,
and security.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#DOMAIN_EXPERT> a owl:Class ;
    rdfs:label "DOMAIN_EXPERT" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Input from multidisciplinary practitioners or scholars who
provide knowledge or expertise in - and about - an industry
sector, context, or application area.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#END_USERS> a owl:Class ;
    rdfs:label "END_USERS" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Individuals or groups that use the AI system for specific
purposes; range in competency from AI experts to first-time
users.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GENERAL_PUBLIC> a owl:Class ;
    rdfs:label "GENERAL_PUBLIC" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Most likely to directly experience positive and negative impacts
of AI technologies; provides motivation for actions taken by
other AI actors.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GOVERNANCE_AND_OVERSIGHT> a owl:Class ;
    rdfs:label "GOVERNANCE_AND_OVERSIGHT" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Assumed by AI actors with management, fiduciary, and legal
authority for the organization, including senior leadership and
the Board of Directors.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#HUMAN_FACTORS> a owl:Class ;
    rdfs:label "HUMAN_FACTORS" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Human-centered design practices and methodologies; promoting
active involvement of end users and other interested parties;
incorporating context-specific norms and values.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OPERATION_AND_MONITORING> a owl:Class ;
    rdfs:label "OPERATION_AND_MONITORING" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Performed in the Application Context / Operate and Monitor
phase; operating the AI system and regularly assessing system
output and impacts.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OTHER_AI_ACTORS> a owl:Class ;
    rdfs:label "OTHER_AI_ACTORS" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Provide formal or quasi-formal norms or guidance - includes
trade associations, standards developing organizations, advocacy
groups, researchers, environmental groups, and civil society
organizations.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#PROCUREMENT> a owl:Class ;
    rdfs:label "PROCUREMENT" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Conducted by AI actors with financial, legal, or policy
management authority for acquisition of AI models, products, or
services from a third party.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#TEVV> a owl:Class ;
    rdfs:label "TEVV" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Test, Evaluation, Verification, and Validation tasks performed
throughout the AI lifecycle; examine the AI system or its
components, and detect and remediate problems.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#THIRD_PARTY_ENTITIES> a owl:Class ;
    rdfs:label "THIRD_PARTY_ENTITIES" ;
    rdfs:subClassOf nist_ai_rmf:AiActorTaskEnum ;
    skos:definition """Providers, developers, vendors, and evaluators of data,
algorithms, models, and/or systems and related services external
to the deploying organization.""" .

nist_ai_rmf:AiLifecycleStage a owl:Class ;
    rdfs:label "AiLifecycleStage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiLifecycleStageEnum ;
            owl:onProperty nist_ai_rmf:stage_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:includes_tevv ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:stage_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:includes_tevv ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:stage_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty nist_ai_rmf:includes_tevv ],
        nist_ai_rmf:NamedThing ;
    skos:definition """A stage of the AI lifecycle (Figure 2): Plan and Design,
Collect and Process Data, Build and Use Model, Verify and
Validate, Deploy and Use, or Operate and Monitor.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

<https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#BUILD_AND_USE_MODEL> a owl:Class ;
    rdfs:label "BUILD_AND_USE_MODEL" ;
    rdfs:subClassOf nist_ai_rmf:AiLifecycleStageEnum ;
    skos:definition "Create or select algorithms; train models (AI Model dimension)." .

<https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA> a owl:Class ;
    rdfs:label "COLLECT_AND_PROCESS_DATA" ;
    rdfs:subClassOf nist_ai_rmf:AiLifecycleStageEnum ;
    skos:definition """Gather, validate, and clean data and document the metadata and
characteristics of the dataset (Data and Input dimension).""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#DEPLOY_AND_USE> a owl:Class ;
    rdfs:label "DEPLOY_AND_USE" ;
    rdfs:subClassOf nist_ai_rmf:AiLifecycleStageEnum ;
    skos:definition """Pilot; check compatibility with legacy systems; verify regulatory
compliance; manage organizational change; and evaluate user
experience (Task and Output dimension).""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#OPERATE_AND_MONITOR> a owl:Class ;
    rdfs:label "OPERATE_AND_MONITOR" ;
    rdfs:subClassOf nist_ai_rmf:AiLifecycleStageEnum ;
    skos:definition """Operate the AI system and continuously assess its recommendations
and impacts (both intended and unintended) in light of objectives,
legal and regulatory requirements, and ethical considerations
(Application Context dimension).""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#PLAN_AND_DESIGN> a owl:Class ;
    rdfs:label "PLAN_AND_DESIGN" ;
    rdfs:subClassOf nist_ai_rmf:AiLifecycleStageEnum ;
    skos:definition """Articulate and document the system's concept and objectives,
underlying assumptions, context, and requirements (Application
Context dimension).""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#VERIFY_AND_VALIDATE> a owl:Class ;
    rdfs:label "VERIFY_AND_VALIDATE" ;
    rdfs:subClassOf nist_ai_rmf:AiLifecycleStageEnum ;
    skos:definition """Verify, validate, calibrate, and interpret model output
(AI Model dimension).""" .

nist_ai_rmf:AiRmfDocument a owl:Class ;
    rdfs:label "AiRmfDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:doi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:published_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty nist_ai_rmf:doi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:publisher ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty nist_ai_rmf:published_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:published_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty nist_ai_rmf:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:version ],
        nist_ai_rmf:NamedThing ;
    skos:closeMatch <https://w3id.org/lmodel/nist-csf-v2/CSFMetadata> ;
    skos:definition """Publication metadata for an instance of the AI RMF (e.g., NIST
AI 100-1, January 2023). The Framework is intended to be a
living document, employing a two-number versioning system (major.minor).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    skos:relatedMatch <http://schema.org/CreativeWork> .

nist_ai_rmf:AiSystem a owl:Class ;
    rdfs:label "AiSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:ai_dimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiSystemDimensionEnum ;
            owl:onProperty nist_ai_rmf:ai_dimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiLifecycleStageEnum ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        nist_ai_rmf:NamedThing ;
    skos:closeMatch <http://schema.org/SoftwareApplication> ;
    skos:definition """An engineered or machine-based system that can, for a given set
of objectives, generate outputs such as predictions,
recommendations, or decisions influencing real or virtual
environments. AI systems are designed to operate with varying
levels of autonomy (Adapted from OECD Recommendation on AI:2019;
ISO/IEC 22989:2022).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:AiSystemDimension a owl:Class ;
    rdfs:label "AiSystemDimension" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiSystemDimensionEnum ;
            owl:onProperty nist_ai_rmf:dimension_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:dimension_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:dimension_kind ],
        nist_ai_rmf:NamedThing ;
    skos:definition """A socio-technical dimension of an AI system (Figure 2):
Application Context, Data and Input, AI Model, Task and Output,
or People and Planet.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

<https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#AI_MODEL> a owl:Class ;
    rdfs:label "AI_MODEL" ;
    rdfs:subClassOf nist_ai_rmf:AiSystemDimensionEnum ;
    skos:definition "The model(s) and algorithms at the heart of an AI system." .

<https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#APPLICATION_CONTEXT> a owl:Class ;
    rdfs:label "APPLICATION_CONTEXT" ;
    rdfs:subClassOf nist_ai_rmf:AiSystemDimensionEnum ;
    skos:definition """The setting in which an AI system is deployed - includes legal,
regulatory, ethical, and societal considerations.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#DATA_AND_INPUT> a owl:Class ;
    rdfs:label "DATA_AND_INPUT" ;
    rdfs:subClassOf nist_ai_rmf:AiSystemDimensionEnum ;
    skos:definition """The data and inputs an AI system uses, including training,
validation, test data, and operational inputs.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#PEOPLE_AND_PLANET> a owl:Class ;
    rdfs:label "PEOPLE_AND_PLANET" ;
    rdfs:subClassOf nist_ai_rmf:AiSystemDimensionEnum ;
    skos:definition """Human rights and the broader well-being of society and the
planet - centred in Figure 2.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#TASK_AND_OUTPUT> a owl:Class ;
    rdfs:label "TASK_AND_OUTPUT" ;
    rdfs:subClassOf nist_ai_rmf:AiSystemDimensionEnum ;
    skos:definition """The task the AI system is designed to perform and the outputs
it produces (predictions, recommendations, decisions).""" .

<https://w3id.org/lmodel/nist-ai-rmf/AudienceEnum#INFORMING> a owl:Class ;
    rdfs:label "INFORMING" ;
    rdfs:subClassOf nist_ai_rmf:AudienceEnum ;
    skos:definition """AI actors in the People and Planet dimension who *inform* the
primary audience - trade associations, standards developers,
researchers, advocacy groups, civil society organisations,
end users, and impacted individuals or communities.""" .

<https://w3id.org/lmodel/nist-ai-rmf/AudienceEnum#PRIMARY> a owl:Class ;
    rdfs:label "PRIMARY" ;
    rdfs:subClassOf nist_ai_rmf:AudienceEnum ;
    skos:definition """AI actors who perform or manage the design, development,
deployment, evaluation, and use of AI systems and drive AI
risk management efforts.""" .

<https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#COMPUTATIONAL_AND_STATISTICAL> a owl:Class ;
    rdfs:label "COMPUTATIONAL_AND_STATISTICAL" ;
    rdfs:subClassOf nist_ai_rmf:BiasCategoryEnum ;
    skos:definition """Bias present in AI datasets and algorithmic processes; often
stems from systematic errors due to non-representative samples.""" .

<https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#HUMAN_COGNITIVE> a owl:Class ;
    rdfs:label "HUMAN_COGNITIVE" ;
    rdfs:subClassOf nist_ai_rmf:BiasCategoryEnum ;
    skos:definition """Bias related to how an individual or group perceives AI system
information to make a decision or fill in missing information;
omnipresent in decision-making across the AI lifecycle.""" .

<https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#SYSTEMIC> a owl:Class ;
    rdfs:label "SYSTEMIC" ;
    rdfs:subClassOf nist_ai_rmf:BiasCategoryEnum ;
    skos:definition """Bias present in AI datasets, organizational norms, practices,
and processes across the AI lifecycle, and the broader society
that uses AI systems.""" .

nist_ai_rmf:Function a owl:Class ;
    rdfs:label "Function" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:categories ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:function_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:function_code ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:function_code ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:Category ;
            owl:onProperty nist_ai_rmf:categories ],
        nist_ai_rmf:NamedThing ;
    skos:definition """A top-level AI RMF Core function. Each function organizes AI risk
management activities at the highest level. GOVERN applies across
all stages; MAP, MEASURE, and MANAGE apply to AI-system-specific
contexts and lifecycle stages.""" ;
    skos:exactMatch <https://w3id.org/lmodel/nist-csf-v2/CSFFunction> ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/gist/Function> .

<https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#GOVERN> a owl:Class ;
    rdfs:label "GOVERN" ;
    rdfs:subClassOf nist_ai_rmf:FunctionEnum ;
    skos:definition """Cultivates and implements a culture of risk management; outlines
processes, documents, and organizational schemes that anticipate,
identify, and manage AI risks.""" .

<https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#MANAGE> a owl:Class ;
    rdfs:label "MANAGE" ;
    rdfs:subClassOf nist_ai_rmf:FunctionEnum ;
    skos:definition """Allocates risk resources to mapped and measured risks on a
regular basis and as defined by the GOVERN function; risk
treatment includes plans to respond to, recover from, and
communicate about incidents or events.""" .

<https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#MAP> a owl:Class ;
    rdfs:label "MAP" ;
    rdfs:subClassOf nist_ai_rmf:FunctionEnum ;
    skos:definition """Establishes the context to frame risks related to an AI system;
identifies risks based on intended purposes, capabilities, and
contextual factors.""" .

<https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#MEASURE> a owl:Class ;
    rdfs:label "MEASURE" ;
    rdfs:subClassOf nist_ai_rmf:FunctionEnum ;
    skos:definition """Employs quantitative, qualitative, or mixed-method tools to
analyze, assess, benchmark, and monitor AI risk and related impacts.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#GV> a owl:Class ;
    rdfs:label "GV" ;
    rdfs:subClassOf nist_ai_rmf:GaiActionFunctionPrefixEnum ;
    skos:definition "Govern function." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#MG> a owl:Class ;
    rdfs:label "MG" ;
    rdfs:subClassOf nist_ai_rmf:GaiActionFunctionPrefixEnum ;
    skos:definition "Manage function." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#MP> a owl:Class ;
    rdfs:label "MP" ;
    rdfs:subClassOf nist_ai_rmf:GaiActionFunctionPrefixEnum ;
    skos:definition "Map function." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#MS> a owl:Class ;
    rdfs:label "MS" ;
    rdfs:subClassOf nist_ai_rmf:GaiActionFunctionPrefixEnum ;
    skos:definition "Measure function." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategorizationEnum#ECOSYSTEM_OR_SOCIETAL_RISKS> a owl:Class ;
    rdfs:label "ECOSYSTEM_OR_SOCIETAL_RISKS" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategorizationEnum ;
    skos:definition """Systemic risks. Examples include data privacy;
environmental impacts; intellectual property.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategorizationEnum#MISUSE_BY_HUMANS> a owl:Class ;
    rdfs:label "MISUSE_BY_HUMANS" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategorizationEnum ;
    skos:definition """Risks from malicious use. Examples include CBRN information
or capabilities; data privacy; human-AI configuration;
obscene, degrading, and/or abusive content; information
integrity; information security.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategorizationEnum#TECHNICAL_OR_MODEL_RISKS> a owl:Class ;
    rdfs:label "TECHNICAL_OR_MODEL_RISKS" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategorizationEnum ;
    skos:definition """Risks from malfunction. Examples include confabulation;
dangerous or violent recommendations; data privacy; value
chain and component integration; harmful bias and
homogenization.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#CBRN_INFORMATION_OR_CAPABILITIES> a owl:Class ;
    rdfs:label "CBRN_INFORMATION_OR_CAPABILITIES" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Eased access to or synthesis of materially nefarious
information or design capabilities related to chemical,
biological, radiological, or nuclear (CBRN) weapons or
other dangerous materials or agents.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#CONFABULATION> a owl:Class ;
    rdfs:label "CONFABULATION" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """The production of confidently stated but erroneous or
false content (colloquially "hallucinations" or
"fabrications") by which users may be misled or deceived.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT> a owl:Class ;
    rdfs:label "DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Eased production of and access to violent, inciting,
radicalizing, or threatening content as well as
recommendations to carry out self-harm or conduct illegal
activities. Includes difficulty controlling public
exposure to hateful and disparaging or stereotyping
content.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#DATA_PRIVACY> a owl:Class ;
    rdfs:label "DATA_PRIVACY" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Impacts due to leakage and unauthorized use, disclosure, or
de-anonymization of biometric, health, location, or other
personally identifiable information or sensitive data.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#ENVIRONMENTAL_IMPACTS> a owl:Class ;
    rdfs:label "ENVIRONMENTAL_IMPACTS" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Impacts due to high compute resource utilization in
training or operating GAI models, and related outcomes that
may adversely impact ecosystems.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#HARMFUL_BIAS_OR_HOMOGENIZATION> a owl:Class ;
    rdfs:label "HARMFUL_BIAS_OR_HOMOGENIZATION" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Amplification and exacerbation of historical, societal,
and systemic biases; performance disparities between
sub-groups or languages, possibly due to non-representative
training data, resulting in discrimination, amplification
of biases, or incorrect presumptions about performance;
undesired homogeneity that skews system or model outputs.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#HUMAN_AI_CONFIGURATION> a owl:Class ;
    rdfs:label "HUMAN_AI_CONFIGURATION" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Arrangements of or interactions between a human and an AI
system which can result in the human inappropriately
anthropomorphising GAI systems or experiencing algorithmic
aversion, automation bias, over-reliance, or emotional
entanglement with GAI systems.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#INFORMATION_INTEGRITY> a owl:Class ;
    rdfs:label "INFORMATION_INTEGRITY" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Lowered barrier to entry to generate and support the
exchange and consumption of content which may not
distinguish fact from opinion or fiction or acknowledge
uncertainties, or could be leveraged for large-scale
dis- and mis-information campaigns.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#INFORMATION_SECURITY> a owl:Class ;
    rdfs:label "INFORMATION_SECURITY" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Lowered barriers for offensive cyber capabilities,
including via automated discovery and exploitation of
vulnerabilities; increased attack surface for targeted
cyberattacks, which may compromise a system's availability
or the confidentiality or integrity of training data,
code, or model weights.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#INTELLECTUAL_PROPERTY> a owl:Class ;
    rdfs:label "INTELLECTUAL_PROPERTY" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Eased production or replication of alleged copyrighted,
trademarked, or licensed content without authorization
(possibly outside fair use); eased exposure of trade
secrets; or plagiarism or illegal replication.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#OBSCENE_DEGRADING_OR_ABUSIVE_CONTENT> a owl:Class ;
    rdfs:label "OBSCENE_DEGRADING_OR_ABUSIVE_CONTENT" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Eased production of and access to obscene, degrading,
and/or abusive imagery which can cause harm, including
synthetic child sexual abuse material (CSAM) and
nonconsensual intimate images (NCII) of adults.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#VALUE_CHAIN_AND_COMPONENT_INTEGRATION> a owl:Class ;
    rdfs:label "VALUE_CHAIN_AND_COMPONENT_INTEGRATION" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition """Non-transparent or untraceable integration of upstream
third-party components, including data that has been
improperly obtained or not processed and cleaned due to
increased automation from GAI; improper supplier vetting
across the AI lifecycle; or other issues that diminish
transparency or accountability for downstream users.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskScopeEnum#APPLICATION_OR_IMPLEMENTATION> a owl:Class ;
    rdfs:label "APPLICATION_OR_IMPLEMENTATION" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskScopeEnum ;
    skos:definition """Specific application or implementation - i.e., a particular
use case.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskScopeEnum#ECOSYSTEM> a owl:Class ;
    rdfs:label "ECOSYSTEM" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskScopeEnum ;
    skos:definition """Beyond a single system or organizational context - e.g.,
algorithmic monocultures, labor-market impacts, creative
economies.""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskScopeEnum#MODEL_OR_SYSTEM> a owl:Class ;
    rdfs:label "MODEL_OR_SYSTEM" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskScopeEnum ;
    skos:definition "Individual GAI model or system level." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#DESIGN> a owl:Class ;
    rdfs:label "DESIGN" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskSourceEnum ;
    skos:definition "From decisions made during model or system design." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#HUMAN_AI_INTERACTION> a owl:Class ;
    rdfs:label "HUMAN_AI_INTERACTION" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskSourceEnum ;
    skos:definition "From interactions between a human and the AI system." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#HUMAN_BEHAVIOR> a owl:Class ;
    rdfs:label "HUMAN_BEHAVIOR" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskSourceEnum ;
    skos:definition """From human behaviour - abuse, misuse, or unsafe repurposing
by humans (adversarial or not).""" .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#MODEL_INPUTS> a owl:Class ;
    rdfs:label "MODEL_INPUTS" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskSourceEnum ;
    skos:definition "From inputs supplied to the model at inference time." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#MODEL_OUTPUTS> a owl:Class ;
    rdfs:label "MODEL_OUTPUTS" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskSourceEnum ;
    skos:definition "From the GAI system's generated outputs." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#OPERATION> a owl:Class ;
    rdfs:label "OPERATION" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskSourceEnum ;
    skos:definition "From operating the GAI model or system." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#TRAINING> a owl:Class ;
    rdfs:label "TRAINING" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskSourceEnum ;
    skos:definition "From the training data or training process." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskTimeScaleEnum#IMMEDIATE> a owl:Class ;
    rdfs:label "IMMEDIATE" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskTimeScaleEnum ;
    skos:definition "Materialises abruptly (e.g., distribution of deepfakes)." .

<https://w3id.org/lmodel/nist-ai-rmf/GaiRiskTimeScaleEnum#PROLONGED> a owl:Class ;
    rdfs:label "PROLONGED" ;
    rdfs:subClassOf nist_ai_rmf:GaiRiskTimeScaleEnum ;
    skos:definition """Materialises across extended periods (e.g., long-term
effect of disinformation on societal trust).""" .

<https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_AN_ECOSYSTEM> a owl:Class ;
    rdfs:label "HARM_TO_AN_ECOSYSTEM" ;
    rdfs:subClassOf nist_ai_rmf:HarmCategoryEnum ;
    skos:definition """Harm to interconnected and interdependent elements and
resources, the global financial system, supply chain, natural
resources, the environment, and the planet.""" .

<https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_AN_ORGANIZATION> a owl:Class ;
    rdfs:label "HARM_TO_AN_ORGANIZATION" ;
    rdfs:subClassOf nist_ai_rmf:HarmCategoryEnum ;
    skos:definition """Harm to an organization's business operations, security
breaches or monetary loss, or reputation.""" .

<https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_PEOPLE> a owl:Class ;
    rdfs:label "HARM_TO_PEOPLE" ;
    rdfs:subClassOf nist_ai_rmf:HarmCategoryEnum ;
    skos:definition """Harm to individuals, groups/communities, or society at large
(including civil liberties, rights, physical or psychological
safety, economic opportunity, democratic participation, and
educational access).""" .

<https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#GROUP_OR_COMMUNITY> a owl:Class ;
    rdfs:label "GROUP_OR_COMMUNITY" ;
    rdfs:subClassOf nist_ai_rmf:HarmToPeopleSubcategoryEnum ;
    skos:definition """Harm to a group such as discrimination against a population
sub-group.""" .

<https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#INDIVIDUAL> a owl:Class ;
    rdfs:label "INDIVIDUAL" ;
    rdfs:subClassOf nist_ai_rmf:HarmToPeopleSubcategoryEnum ;
    skos:definition """Harm to a person's civil liberties, rights, physical or
psychological safety, or economic opportunity.""" .

<https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#SOCIETAL> a owl:Class ;
    rdfs:label "SOCIETAL" ;
    rdfs:subClassOf nist_ai_rmf:HarmToPeopleSubcategoryEnum ;
    skos:definition "Harm to democratic participation or educational access." .

nist_ai_rmf:HumanAiInteractionIssue a owl:Class ;
    rdfs:label "HumanAiInteractionIssue" ;
    rdfs:subClassOf nist_ai_rmf:NamedThing ;
    skos:definition """An issue that merits further consideration in human-AI
interaction (Appendix C) - e.g., clear human roles and
responsibilities, systemic and human-cognitive biases in design,
variability of human-AI interaction outcomes, complexity of
presenting AI system information to humans.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/iso27001/InterestedParty> .

nist_ai_rmf:Impact a owl:Class ;
    rdfs:label "Impact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1e+00 ] ) ] ) ] ;
            owl:onProperty nist_ai_rmf:likelihood ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:impact_sign ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:impact_sign ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:affects ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:likelihood ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:ImpactSignEnum ;
            owl:onProperty nist_ai_rmf:impact_sign ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:magnitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:NamedThing ;
            owl:onProperty nist_ai_rmf:affects ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:likelihood ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:magnitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:magnitude ],
        nist_ai_rmf:NamedThing ;
    skos:definition """A positive, negative, or both consequence of an AI system. Impacts
can manifest as opportunities (positive) or threats (negative).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    skos:narrowMatch <https://w3id.org/lmodel/iso27001/ImpactRating> .

<https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#MIXED> a owl:Class ;
    rdfs:label "MIXED" ;
    rdfs:subClassOf nist_ai_rmf:ImpactSignEnum ;
    skos:definition "An impact that is both positive and negative." .

<https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#NEGATIVE> a owl:Class ;
    rdfs:label "NEGATIVE" ;
    rdfs:subClassOf nist_ai_rmf:ImpactSignEnum ;
    skos:definition "A harmful impact or threat." .

<https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#POSITIVE> a owl:Class ;
    rdfs:label "POSITIVE" ;
    rdfs:subClassOf nist_ai_rmf:ImpactSignEnum ;
    skos:definition "A beneficial impact or opportunity." .

<https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#CONTENT_PROVENANCE> a owl:Class ;
    rdfs:label "CONTENT_PROVENANCE" ;
    rdfs:subClassOf nist_ai_rmf:PrimaryConsiderationEnum ;
    skos:definition """Digital transparency mechanisms (provenance data tracking,
watermarking, synthetic content detection) for tracing
origin and history of content (A.1.6 - A.1.7).""" .

<https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#GOVERNANCE> a owl:Class ;
    rdfs:label "GOVERNANCE" ;
    rdfs:subClassOf nist_ai_rmf:PrimaryConsiderationEnum ;
    skos:definition """How organizational governance regimes may be re-evaluated
and adjusted for GAI contexts (A.1).""" .

<https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#INCIDENT_DISCLOSURE> a owl:Class ;
    rdfs:label "INCIDENT_DISCLOSURE" ;
    rdfs:subClassOf nist_ai_rmf:PrimaryConsiderationEnum ;
    skos:definition """Documenting, reporting, and sharing information about AI
incidents to mitigate harm and improve risk management
(A.1.8).""" .

<https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#PRE_DEPLOYMENT_TESTING> a owl:Class ;
    rdfs:label "PRE_DEPLOYMENT_TESTING" ;
    rdfs:subClassOf nist_ai_rmf:PrimaryConsiderationEnum ;
    skos:definition """Test, evaluation, validation, and verification practices
appropriate for GAI prior to deployment (A.1.4).""" .

<https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#CROSS_SECTORAL> a owl:Class ;
    rdfs:label "CROSS_SECTORAL" ;
    rdfs:subClassOf nist_ai_rmf:ProfileTypeEnum ;
    skos:definition """Risks of models or applications used across use cases or
sectors (e.g., large language models, cloud-based services,
acquisition).""" .

<https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#TEMPORAL_CURRENT> a owl:Class ;
    rdfs:label "TEMPORAL_CURRENT" ;
    rdfs:subClassOf nist_ai_rmf:ProfileTypeEnum ;
    skos:definition """Description of the current state of AI risk management
activities within a sector, industry, organization, or
application context.""" .

<https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#TEMPORAL_TARGET> a owl:Class ;
    rdfs:label "TEMPORAL_TARGET" ;
    rdfs:subClassOf nist_ai_rmf:ProfileTypeEnum ;
    skos:definition """Description of the desired or target state of AI risk
management activities.""" .

<https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#USE_CASE> a owl:Class ;
    rdfs:label "USE_CASE" ;
    rdfs:subClassOf nist_ai_rmf:ProfileTypeEnum ;
    skos:definition """Implementation of the AI RMF Core for a specific setting or
application (e.g., a hiring profile, a fair housing profile).""" .

<https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#COMBINATION> a owl:Class ;
    rdfs:label "COMBINATION" ;
    rdfs:subClassOf nist_ai_rmf:RedTeamingTypeEnum ;
    skos:definition """Hybrid exercises using both expert and general-public
participants.""" .

<https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#EXPERT> a owl:Class ;
    rdfs:label "EXPERT" ;
    rdfs:subClassOf nist_ai_rmf:RedTeamingTypeEnum ;
    skos:definition """Performed by specialists with expertise in the domain or
specific red-teaming context (medicine, biotech,
cybersecurity).""" .

<https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#GENERAL_PUBLIC> a owl:Class ;
    rdfs:label "GENERAL_PUBLIC" ;
    rdfs:subClassOf nist_ai_rmf:RedTeamingTypeEnum ;
    skos:definition """Performed by general users not necessarily having AI or
technical expertise.""" .

<https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#HUMAN_AND_AI> a owl:Class ;
    rdfs:label "HUMAN_AND_AI" ;
    rdfs:subClassOf nist_ai_rmf:RedTeamingTypeEnum ;
    skos:definition """Performed by GAI in combination with specialist or
non-specialist human teams.""" .

nist_ai_rmf:Risk a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:RiskResponseEnum ;
            owl:onProperty nist_ai_rmf:risk_response ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiSystem ;
            owl:onProperty nist_ai_rmf:affects_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:risk_response ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:ImpactSignEnum ;
            owl:onProperty nist_ai_rmf:impact_sign ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:trustworthiness_characteristic ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:Impact ;
            owl:onProperty nist_ai_rmf:related_impacts ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty nist_ai_rmf:is_residual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:magnitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:TrustworthinessCharacteristicEnum ;
            owl:onProperty nist_ai_rmf:trustworthiness_characteristic ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:is_residual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:risk_response ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:affects_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:related_impacts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:likelihood ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:likelihood ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:affects_system ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:magnitude ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:is_residual ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1e+00 ] ) ] ) ] ;
            owl:onProperty nist_ai_rmf:likelihood ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiLifecycleStageEnum ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:impact_sign ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:magnitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:impact_sign ],
        nist_ai_rmf:NamedThing ;
    skos:definition """The composite measure of an event's probability of occurring and
the magnitude or degree of the consequences of that event. When
considering negative impact, risk is a function of (1) the
negative impact or magnitude of harm and (2) the likelihood of
occurrence (Adapted from ISO 31000:2018; OMB Circular A-130:2016).""" ;
    skos:exactMatch <https://w3id.org/lmodel/iso27001/Risk> ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/iso29100/PrivacyRisk> .

nist_ai_rmf:RiskMeasurementChallenge a owl:Class ;
    rdfs:label "RiskMeasurementChallenge" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:challenge_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:challenge_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:RiskMeasurementChallengeEnum ;
            owl:onProperty nist_ai_rmf:challenge_kind ],
        nist_ai_rmf:NamedThing ;
    skos:definition """A challenge that complicates measurement of AI risks
(Part 1 §1.2.1).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

<https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#AVAILABILITY_OF_RELIABLE_METRICS> a owl:Class ;
    rdfs:label "AVAILABILITY_OF_RELIABLE_METRICS" ;
    rdfs:subClassOf nist_ai_rmf:RiskMeasurementChallengeEnum ;
    skos:definition """Lack of consensus on robust and verifiable measurement methods
for risk and trustworthiness, and their applicability to
different use cases.""" .

<https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#HUMAN_BASELINE> a owl:Class ;
    rdfs:label "HUMAN_BASELINE" ;
    rdfs:subClassOf nist_ai_rmf:RiskMeasurementChallengeEnum ;
    skos:definition """AI systems intended to augment or replace human activity
require a human baseline for comparison, which is difficult to
systematize.""" .

<https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#INSCRUTABILITY> a owl:Class ;
    rdfs:label "INSCRUTABILITY" ;
    rdfs:subClassOf nist_ai_rmf:RiskMeasurementChallengeEnum ;
    skos:definition """Opaque systems with limited explainability or interpretability,
poor documentation, or inherent uncertainty complicate risk
measurement.""" .

<https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#RISK_AT_DIFFERENT_LIFECYCLE_STAGES> a owl:Class ;
    rdfs:label "RISK_AT_DIFFERENT_LIFECYCLE_STAGES" ;
    rdfs:subClassOf nist_ai_rmf:RiskMeasurementChallengeEnum ;
    skos:definition """Measuring risk at different stages may yield different results;
some risks may be latent and increase as systems adapt and
evolve.""" .

<https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#RISK_IN_REAL_WORLD_SETTINGS> a owl:Class ;
    rdfs:label "RISK_IN_REAL_WORLD_SETTINGS" ;
    rdfs:subClassOf nist_ai_rmf:RiskMeasurementChallengeEnum ;
    skos:definition """Lab measurements may differ from risks that emerge in
operational, real-world settings.""" .

<https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#THIRD_PARTY_SOFTWARE_HARDWARE_AND_DATA> a owl:Class ;
    rdfs:label "THIRD_PARTY_SOFTWARE_HARDWARE_AND_DATA" ;
    rdfs:subClassOf nist_ai_rmf:RiskMeasurementChallengeEnum ;
    skos:definition """Risks related to third-party software, hardware, and data,
including misalignment of risk metrics or methodologies between
developers, deployers, and operators.""" .

<https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#TRACKING_EMERGENT_RISKS> a owl:Class ;
    rdfs:label "TRACKING_EMERGENT_RISKS" ;
    rdfs:subClassOf nist_ai_rmf:RiskMeasurementChallengeEnum ;
    skos:definition """Identifying and tracking emergent risks and considering
techniques for measuring them; impact assessment helps
understand context-specific harms.""" .

<https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#ACCEPTING> a owl:Class ;
    rdfs:label "ACCEPTING" ;
    rdfs:subClassOf nist_ai_rmf:RiskResponseEnum ;
    skos:definition "Acknowledging the risk and taking no further action." .

<https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#AVOIDING> a owl:Class ;
    rdfs:label "AVOIDING" ;
    rdfs:subClassOf nist_ai_rmf:RiskResponseEnum ;
    skos:definition "Choosing not to engage in the activity that creates the risk." .

<https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#MITIGATING> a owl:Class ;
    rdfs:label "MITIGATING" ;
    rdfs:subClassOf nist_ai_rmf:RiskResponseEnum ;
    skos:definition "Reducing the likelihood or magnitude of the risk." .

<https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#TRANSFERRING> a owl:Class ;
    rdfs:label "TRANSFERRING" ;
    rdfs:subClassOf nist_ai_rmf:RiskResponseEnum ;
    skos:definition "Shifting the risk to another party (e.g., via insurance or contract)." .

nist_ai_rmf:RmfAttribute a owl:Class ;
    rdfs:label "RmfAttribute" ;
    rdfs:subClassOf nist_ai_rmf:NamedThing ;
    skos:definition """A design attribute of the AI RMF (Appendix D) - one of the
qualities the Framework strives to embody (e.g., risk-based,
consensus-driven, plain language, common language, easily usable,
universally applicable, outcome-focused, leveraging existing
standards, law- and regulation-agnostic, living document).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/nist-csf-v2/CSFProperty> .

<https://w3id.org/lmodel/nist-ai-rmf/StructuredFeedbackMethodEnum#AI_RED_TEAMING> a owl:Class ;
    rdfs:label "AI_RED_TEAMING" ;
    rdfs:subClassOf nist_ai_rmf:StructuredFeedbackMethodEnum ;
    skos:definition """A structured testing exercise used to probe an AI system
to find flaws and vulnerabilities such as inaccurate,
harmful, or discriminatory outputs.""" .

<https://w3id.org/lmodel/nist-ai-rmf/StructuredFeedbackMethodEnum#FIELD_TESTING> a owl:Class ;
    rdfs:label "FIELD_TESTING" ;
    rdfs:subClassOf nist_ai_rmf:StructuredFeedbackMethodEnum ;
    skos:definition """Methods used to determine how people interact with,
consume, use, and make sense of AI-generated information
(UX, usability, randomised experiments).""" .

<https://w3id.org/lmodel/nist-ai-rmf/StructuredFeedbackMethodEnum#PARTICIPATORY_ENGAGEMENT_METHODS> a owl:Class ;
    rdfs:label "PARTICIPATORY_ENGAGEMENT_METHODS" ;
    rdfs:subClassOf nist_ai_rmf:StructuredFeedbackMethodEnum ;
    skos:definition """Methods used to solicit feedback from civil society groups,
affected communities, and users (focus groups, small user
studies, surveys).""" .

nist_ai_rmf:TrustworthinessCharacteristic a owl:Class ;
    rdfs:label "TrustworthinessCharacteristic" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:characteristic_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:is_base_condition ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:characteristic_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty nist_ai_rmf:is_base_condition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:is_cross_cutting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:is_cross_cutting ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:is_base_condition ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:TrustworthinessCharacteristicEnum ;
            owl:onProperty nist_ai_rmf:characteristic_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty nist_ai_rmf:is_cross_cutting ],
        nist_ai_rmf:NamedThing ;
    skos:definition """A characteristic of a trustworthy AI system (Figure 4 / Part 1
§3). The seven characteristics are inter-related; addressing them
individually does not guarantee trustworthiness, and tradeoffs
are usually involved.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

<https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT> a owl:Class ;
    rdfs:label "ACCOUNTABLE_AND_TRANSPARENT" ;
    rdfs:subClassOf nist_ai_rmf:TrustworthinessCharacteristicEnum ;
    skos:definition """Trustworthy AI depends on accountability, which presupposes
transparency - the extent to which information about an AI
system and its outputs is available to those interacting with
it.""" .

<https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE> a owl:Class ;
    rdfs:label "EXPLAINABLE_AND_INTERPRETABLE" ;
    rdfs:subClassOf nist_ai_rmf:TrustworthinessCharacteristicEnum ;
    skos:definition """Explainability concerns the mechanisms underlying an AI system's
operation; interpretability concerns the meaning of its output
in context.""" .

<https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> a owl:Class ;
    rdfs:label "FAIR_WITH_HARMFUL_BIAS_MANAGED" ;
    rdfs:subClassOf nist_ai_rmf:TrustworthinessCharacteristicEnum ;
    skos:definition """Concerns for equality and equity by addressing issues such as
harmful bias and discrimination, and recognising that
perceptions of fairness differ across cultures and
applications.""" .

<https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED> a owl:Class ;
    rdfs:label "PRIVACY_ENHANCED" ;
    rdfs:subClassOf nist_ai_rmf:TrustworthinessCharacteristicEnum ;
    skos:definition """Norms and practices that help safeguard human autonomy,
identity, and dignity - including anonymity, confidentiality,
and control over personal information.""" .

<https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SAFE> a owl:Class ;
    rdfs:label "SAFE" ;
    rdfs:subClassOf nist_ai_rmf:TrustworthinessCharacteristicEnum ;
    skos:definition """The system does not, under defined conditions, lead to a state
in which human life, health, property, or the environment is
endangered.""" .

<https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT> a owl:Class ;
    rdfs:label "SECURE_AND_RESILIENT" ;
    rdfs:subClassOf nist_ai_rmf:TrustworthinessCharacteristicEnum ;
    skos:definition """The system can withstand unexpected adverse events or changes
(resilient) and maintain confidentiality, integrity, and
availability through protection mechanisms (secure).""" .

<https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE> a owl:Class ;
    rdfs:label "VALID_AND_RELIABLE" ;
    rdfs:subClassOf nist_ai_rmf:TrustworthinessCharacteristicEnum ;
    skos:definition """Confirmation that requirements for a specific intended use have
been fulfilled (validation) and that the system performs as
required without failure (reliability). A necessary condition of
trustworthiness and the base for other characteristics.""" .

nist_ai_rmf:actor_tasks a owl:ObjectProperty ;
    rdfs:label "actor_tasks" ;
    skos:definition "AI actor task categories (Appendix A)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:addresses a owl:ObjectProperty ;
    rdfs:label "addresses" ;
    skos:definition "Subcategories that the profile implements or addresses." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:ai_actor_categories a owl:DatatypeProperty ;
    rdfs:label "ai_actor_categories" ;
    rdfs:range xsd:string ;
    skos:definition """Free-text list of AI Actor categories the entry applies to,
preserving the original case used in the AI RMF Playbook
(e.g., "Governance and Oversight", "TEVV"). For controlled
enum values see `actor_task` (range AiActorTaskEnum).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:ai_actors a owl:DatatypeProperty ;
    rdfs:label "ai_actors" ;
    skos:definition """AI actor categories the entry applies to. Free-text to
preserve the casing of the source data (e.g., "Governance
and Oversight").""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:ai_specific_risks a owl:ObjectProperty ;
    rdfs:label "ai_specific_risks" ;
    skos:definition "AI-specific risks compared to traditional software (Appendix B)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:attributes_ a owl:ObjectProperty ;
    rdfs:label "attributes_" ;
    skos:altLabel "rmf_attributes" ;
    skos:definition "Design attributes of the AI RMF (Appendix D)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:bias_category a owl:ObjectProperty ;
    rdfs:label "bias_category" ;
    rdfs:range nist_ai_rmf:BiasCategoryEnum ;
    skos:definition "Category or categories of bias addressed." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:categories a owl:ObjectProperty ;
    rdfs:label "categories" ;
    rdfs:range nist_ai_rmf:Category ;
    skos:definition "Categories that belong to a Function." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:dimensions a owl:ObjectProperty ;
    rdfs:label "dimensions" ;
    skos:definition "The AI system dimensions (Figure 2)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:entries a owl:ObjectProperty ;
    rdfs:label "entries" ;
    skos:definition "The Playbook entries in this collection." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:functions a owl:ObjectProperty ;
    rdfs:label "functions" ;
    skos:definition "The four AI RMF Core functions and their content." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:human_ai_interaction_issues a owl:ObjectProperty ;
    rdfs:label "human_ai_interaction_issues" ;
    skos:definition "Human-AI interaction considerations (Appendix C)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:lifecycle_stages a owl:ObjectProperty ;
    rdfs:label "lifecycle_stages" ;
    skos:definition "The AI lifecycle stages (Figure 2)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:profiles a owl:ObjectProperty ;
    rdfs:label "profiles" ;
    skos:definition "AI RMF profiles defined alongside this Framework instance." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:related_impacts a owl:ObjectProperty ;
    rdfs:label "related_impacts" ;
    skos:definition "The impacts that contribute to this risk." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:risk_measurement_challenges a owl:ObjectProperty ;
    rdfs:label "risk_measurement_challenges" ;
    skos:definition "Identified challenges in measuring AI risk." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:see_also a owl:DatatypeProperty ;
    rdfs:label "see_also" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Related references." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:subcategories a owl:ObjectProperty ;
    rdfs:label "subcategories" ;
    rdfs:range nist_ai_rmf:Subcategory ;
    skos:definition "Subcategories that belong to a Category." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:topic a owl:DatatypeProperty ;
    rdfs:label "topic" ;
    skos:definition """Topic tags (e.g., "Legal and Regulatory", "Validity and
Reliability").""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:topics a owl:DatatypeProperty ;
    rdfs:label "topics" ;
    rdfs:range xsd:string ;
    skos:definition """Free-text topic tags applied to a playbook entry (e.g.,
"Governance", "Trustworthy Characteristics", "Validity and
Reliability").""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:trustworthiness_characteristics a owl:ObjectProperty ;
    rdfs:label "trustworthiness_characteristics" ;
    skos:definition "The seven characteristics of trustworthy AI." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:typical_actors a owl:DatatypeProperty ;
    rdfs:label "typical_actors" ;
    skos:definition "Representative actor roles that perform this task." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_600_1:StructuredPublicFeedback a owl:Class ;
    rdfs:label "StructuredPublicFeedback" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:StructuredFeedbackMethodEnum ;
            owl:onProperty nist_ai_600_1:feedback_method_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_600_1:feedback_method_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:feedback_method_kind ],
        nist_ai_rmf:NamedThing ;
    skos:definition """Methods used to evaluate whether GAI systems are performing as
intended and to calibrate and verify traditional measurement
methods (A.1.5).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/iso27001/InterestedParty> .

nist_ai_600_1:SuggestedAction a owl:Class ;
    rdfs:label "SuggestedAction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:applies_to_subcategory ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_600_1:action_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:GaiActionFunctionPrefixEnum ;
            owl:onProperty nist_ai_600_1:function_prefix ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:actor_task ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:action_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_600_1:applies_to_subcategory ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:action_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_600_1:function_prefix ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:GaiRiskCategoryEnum ;
            owl:onProperty nist_ai_600_1:gai_risks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:gai_risks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:applies_to_subcategory ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiActorTaskEnum ;
            owl:onProperty nist_ai_rmf:actor_task ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_600_1:function_prefix ],
        nist_ai_rmf:NamedThing ;
    skos:closeMatch <https://w3id.org/lmodel/stix/CourseOfAction> ;
    skos:definition """A suggested action an organisation can take to manage GAI
risks. Each action is identified by an Action ID, linked to an
AI RMF subcategory, and may be relevant to one or more GAI
risks and AI actor tasks (NIST AI 600-1 Section 3).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    skos:relatedMatch <https://w3id.org/lmodel/gist/Task>,
        <https://w3id.org/lmodel/oscal_catalog/Control> .

nist_ai_600_1:action_id a owl:DatatypeProperty ;
    rdfs:label "action_id" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier of a Suggested Action." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:ai_incident_definition a owl:DatatypeProperty ;
    rdfs:label "ai_incident_definition" ;
    skos:definition """For Incident Disclosure: the definition of AI incident
used by the organisation (A.1.8).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:applies_to_subcategory a owl:DatatypeProperty ;
    rdfs:label "applies_to_subcategory" ;
    rdfs:range xsd:string ;
    skos:closeMatch <https://w3id.org/lmodel/oscal_profile/Profile> ;
    skos:definition "Identifier of the AI RMF subcategory the action applies to." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:consideration_kind a owl:ObjectProperty ;
    rdfs:label "consideration_kind" ;
    rdfs:range nist_ai_rmf:PrimaryConsiderationEnum ;
    skos:definition "Which primary consideration this element represents." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:feedback_method_kind a owl:ObjectProperty ;
    rdfs:label "feedback_method_kind" ;
    rdfs:range nist_ai_rmf:StructuredFeedbackMethodEnum ;
    skos:definition "Which structured feedback method this element represents." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:function_prefix a owl:ObjectProperty ;
    rdfs:label "function_prefix" ;
    rdfs:range nist_ai_rmf:GaiActionFunctionPrefixEnum ;
    skos:definition "Two-letter function prefix of the action's subcategory." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:gai_risk_kind a owl:ObjectProperty ;
    rdfs:label "gai_risk_kind" ;
    rdfs:range nist_ai_rmf:GaiRiskCategoryEnum ;
    skos:definition "The GAI risk category this element represents." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:limitations_of_current_approaches a owl:DatatypeProperty ;
    rdfs:label "limitations_of_current_approaches" ;
    skos:definition """For Pre-Deployment Testing: free-text discussion of why
current TEVV approaches may be inadequate (A.1.4).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:red_team_type a owl:ObjectProperty ;
    rdfs:label "red_team_type" ;
    rdfs:range nist_ai_rmf:RedTeamingTypeEnum ;
    skos:definition "The type of AI red-teaming exercise." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:risk_categorization a owl:ObjectProperty ;
    rdfs:label "risk_categorization" ;
    rdfs:range nist_ai_rmf:GaiRiskCategorizationEnum ;
    skos:definition """Higher-level categorisation - technical/model, misuse, or
ecosystem/societal.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_600_1:third_party_considerations a owl:DatatypeProperty ;
    rdfs:label "third_party_considerations" ;
    skos:definition """Considerations for third-party GAI integrations,
procurement, SBOMs, SLAs, and SSAE reports (A.1.3).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> .

nist_ai_rmf:AiRmfProfile a owl:Class ;
    rdfs:label "AiRmfProfile" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:addresses ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:sector ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:sector ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:current_state ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:target_state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:sector ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:profile_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:ProfileTypeEnum ;
            owl:onProperty nist_ai_rmf:profile_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:target_state ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:current_state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:current_state ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:Subcategory ;
            owl:onProperty nist_ai_rmf:addresses ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:target_state ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:profile_type ],
        nist_ai_rmf:NamedThing ;
    skos:closeMatch <https://w3id.org/lmodel/nist-sp-800-53/ProfileDocument> ;
    skos:definition """An implementation of the AI RMF Functions, Categories, and
Subcategories for a specific setting or application based on the
requirements, risk tolerance, and resources of the user (§6).
Profiles may be use-case-specific, temporal (current or target),
or cross-sectoral.""" ;
    skos:exactMatch <https://w3id.org/lmodel/oscal_profile/Profile> ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:Category a owl:Class ;
    rdfs:label "Category" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:outcome ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:subcategories ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:category_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:Subcategory ;
            owl:onProperty nist_ai_rmf:subcategories ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:category_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:outcome ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:outcome ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:category_id ],
        nist_ai_rmf:NamedThing ;
    skos:definition """A category within an AI RMF Core function (e.g., "GOVERN 1:
Policies, processes, procedures, and practices ... are in place,
transparent, and implemented effectively"). Categories group
related subcategories.""" ;
    skos:exactMatch <https://w3id.org/lmodel/nist-csf-v2/CSFCategory> ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:about_text a owl:DatatypeProperty ;
    rdfs:label "about_text" ;
    rdfs:range xsd:string ;
    skos:definition """Free-text discussion of the subcategory or related concept.
Corresponds to the AI RMF Playbook "About" section.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:affects_system a owl:ObjectProperty ;
    rdfs:label "affects_system" ;
    skos:definition "The AI system this risk pertains to." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:audience a owl:ObjectProperty ;
    rdfs:label "audience" ;
    rdfs:range nist_ai_rmf:AudienceEnum ;
    skos:definition """Whether the actor is part of the *primary* AI RMF audience or the
*informing* People-and-Planet audience.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:category a owl:DatatypeProperty ;
    rdfs:label "category" ;
    skos:definition """Category code in the form "FUNCTION-N" (e.g., "GOVERN-1")
as used in the Playbook.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:category_id a owl:DatatypeProperty ;
    rdfs:label "category_id" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier of a Category (e.g., \"GOVERN 1\")." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:challenge_kind a owl:ObjectProperty ;
    rdfs:label "challenge_kind" ;
    skos:definition "Which measurement challenge this represents." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:characteristic_kind a owl:ObjectProperty ;
    rdfs:label "characteristic_kind" ;
    skos:definition "Which trustworthiness characteristic this instance represents." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:current_state a owl:DatatypeProperty ;
    rdfs:label "current_state" ;
    rdfs:range xsd:string ;
    skos:definition """For temporal current profiles - how AI is currently being managed
and related risks in terms of current outcomes.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:dimension_kind a owl:ObjectProperty ;
    rdfs:label "dimension_kind" ;
    skos:definition "Which of the five dimensions this instance represents." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:document a owl:ObjectProperty ;
    rdfs:label "document" ;
    skos:definition "Publication metadata." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:documentation_questions a owl:DatatypeProperty ;
    rdfs:label "documentation_questions" ;
    rdfs:range xsd:string ;
    skos:definition """Free-text documentation questions and transparency resources.
Corresponds to the AI RMF Playbook "Documentation" section.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:doi a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Digital Object Identifier for the document." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:function_code a owl:DatatypeProperty ;
    rdfs:label "function_code" ;
    rdfs:range xsd:string ;
    skos:definition "The function code (GOVERN, MAP, MEASURE, or MANAGE)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:harm_category a owl:ObjectProperty ;
    rdfs:label "harm_category" ;
    rdfs:range nist_ai_rmf:HarmCategoryEnum ;
    skos:definition "The high-level harm category (people / organization / ecosystem)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:harm_to_people_subcategory a owl:ObjectProperty ;
    rdfs:label "harm_to_people_subcategory" ;
    rdfs:range nist_ai_rmf:HarmToPeopleSubcategoryEnum ;
    skos:definition "The sub-category when harm is to people (individual / group / societal)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:includes_tevv a owl:DatatypeProperty ;
    rdfs:label "includes_tevv" ;
    skos:definition "Whether this stage incorporates TEVV activities." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:is_base_condition a owl:DatatypeProperty ;
    rdfs:label "is_base_condition" ;
    skos:definition """True when this is a necessary condition for trustworthiness
(Valid and Reliable; per Figure 4 it is the base of all other
characteristics).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:is_cross_cutting a owl:DatatypeProperty ;
    rdfs:label "is_cross_cutting" ;
    skos:definition """True when this characteristic relates to all others
(Accountable and Transparent; shown vertically in Figure 4).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:is_tevv a owl:DatatypeProperty ;
    rdfs:label "is_tevv" ;
    rdfs:range xsd:boolean ;
    skos:definition """Whether the actor or task is a Test, Evaluation, Verification, and
Validation (TEVV) actor / task.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:legal_basis a owl:DatatypeProperty ;
    rdfs:label "legal_basis" ;
    skos:definition "Legal or regulatory requirements influencing the tolerance." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "A short human-readable name." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:published_date a owl:DatatypeProperty ;
    rdfs:label "published_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the document was published." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:publisher a owl:DatatypeProperty ;
    rdfs:label "publisher" ;
    rdfs:range xsd:string ;
    skos:definition "The publisher of the document (e.g., NIST)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:references_text a owl:DatatypeProperty ;
    rdfs:label "references_text" ;
    rdfs:range xsd:string ;
    skos:definition """Free-text list of references, citations, and supporting
resources. Corresponds to the AI RMF Playbook "References"
section.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:risk_response a owl:ObjectProperty ;
    rdfs:label "risk_response" ;
    rdfs:range nist_ai_rmf:RiskResponseEnum ;
    skos:definition "The chosen risk treatment option." ;
    skos:exactMatch <https://w3id.org/lmodel/iso27001/RiskTreatmentOption> ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:section_about a owl:DatatypeProperty ;
    rdfs:label "section_about" ;
    skos:definition "Free-text discussion (\"About\" section)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:section_actions a owl:DatatypeProperty ;
    rdfs:label "section_actions" ;
    skos:definition "Bulleted suggested actions (\"Actions\" section)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:section_doc a owl:DatatypeProperty ;
    rdfs:label "section_doc" ;
    skos:definition """Documentation questions and transparency resources
("Documentation" section).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:section_ref a owl:DatatypeProperty ;
    rdfs:label "section_ref" ;
    skos:definition "References and citations (\"References\" section)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:sector a owl:DatatypeProperty ;
    rdfs:label "sector" ;
    skos:definition """The sector, industry, technology, or end-use application the
profile addresses (e.g., "hiring", "fair housing").""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:source a owl:DatatypeProperty ;
    rdfs:label "source" ;
    rdfs:range xsd:anyURI ;
    skos:definition """Reference to the source of the element (typically the document
or section it originated from).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:stage_kind a owl:ObjectProperty ;
    rdfs:label "stage_kind" ;
    skos:definition "Which of the six stages this instance represents." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:subcategory_id a owl:DatatypeProperty ;
    rdfs:label "subcategory_id" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier of a Subcategory (e.g., \"GOVERN 1.1\")." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:suggested_actions_text a owl:DatatypeProperty ;
    rdfs:label "suggested_actions_text" ;
    rdfs:range xsd:string ;
    skos:definition """Free-text bulleted list of suggested actions an organization can
take. Corresponds to the AI RMF Playbook "Actions" section.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:target_state a owl:DatatypeProperty ;
    rdfs:label "target_state" ;
    rdfs:range xsd:string ;
    skos:definition """For temporal target profiles - the outcomes needed to achieve the
desired AI risk management goals.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:task_kind a owl:ObjectProperty ;
    rdfs:label "task_kind" ;
    skos:definition "Which of the actor task categories this is." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:tolerance_statement a owl:DatatypeProperty ;
    rdfs:label "tolerance_statement" ;
    skos:definition "Free-text statement of the tolerance level or threshold." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    skos:definition """Function label as serialised in the published Playbook JSON
(Title case - "Govern", "Map", "Measure", "Manage"). For
the controlled enum see `function_kind`.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:range xsd:string ;
    skos:definition "Version identifier of the document." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:AiSpecificRisk a owl:Class ;
    rdfs:label "AiSpecificRisk" ;
    rdfs:subClassOf nist_ai_rmf:NamedThing ;
    skos:broadMatch <https://w3id.org/lmodel/iso27001/Risk> ;
    skos:definition """A risk that is new or increased for AI-based technology compared
to traditional software (Appendix B) - e.g., data quality, model
drift, opacity, scale and complexity, pre-trained model
uncertainty, emergent properties, privacy aggregation, or
environmental cost.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:AudienceEnum a owl:Class ;
    rdfs:label "AudienceEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/AudienceEnum#PRIMARY> <https://w3id.org/lmodel/nist-ai-rmf/AudienceEnum#INFORMING> ) ;
    skos:definition "Audience categorisation for the AI RMF (Part 1 §2)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/AudienceEnum#INFORMING>,
        <https://w3id.org/lmodel/nist-ai-rmf/AudienceEnum#PRIMARY> .

nist_ai_rmf:GaiRiskTimeScaleEnum a owl:Class ;
    rdfs:label "GaiRiskTimeScaleEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskTimeScaleEnum#IMMEDIATE> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskTimeScaleEnum#PROLONGED> ) ;
    skos:definition """The time scale over which a GAI risk may materialise
(Section 2).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskTimeScaleEnum#IMMEDIATE>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskTimeScaleEnum#PROLONGED> .

nist_ai_rmf:Subcategory a owl:Class ;
    rdfs:label "Subcategory" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:documentation_questions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:outcome ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:AiLifecycleStageEnum ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:suggested_actions_text ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:subcategory_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:references_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:outcome ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:ai_actor_categories ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:references_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:topics ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:topics ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:subcategory_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:lifecycle_stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:documentation_questions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:references_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:ai_actor_categories ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:documentation_questions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:outcome ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:suggested_actions_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom nist_ai_rmf:TrustworthinessCharacteristicEnum ;
            owl:onProperty nist_ai_rmf:trustworthiness_characteristic ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:trustworthiness_characteristic ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:about_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:subcategory_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:about_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:suggested_actions_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:about_text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:id ],
        nist_ai_rmf:NamedThing ;
    skos:closeMatch <https://w3id.org/lmodel/nist-sp-800-53/Control>,
        <https://w3id.org/lmodel/oscal_catalog/Control> ;
    skos:definition """A subcategory within an AI RMF Core category (e.g., "GOVERN 1.1:
Legal and regulatory requirements involving AI are understood,
managed, and documented"). Subcategories express specific
outcomes.""" ;
    skos:exactMatch <https://w3id.org/lmodel/nist-csf-v2/CSFSubcategory> ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:actor_task a owl:ObjectProperty ;
    rdfs:label "actor_task" ;
    rdfs:range nist_ai_rmf:AiActorTaskEnum ;
    skos:definition "AI actor task category." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:affects a owl:ObjectProperty ;
    rdfs:label "affects" ;
    rdfs:range nist_ai_rmf:NamedThing ;
    skos:definition """Entities (people, organizations, ecosystems) the risk or harm
may affect.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:ai_dimension a owl:ObjectProperty ;
    rdfs:label "ai_dimension" ;
    rdfs:range nist_ai_rmf:AiSystemDimensionEnum ;
    skos:definition "The AI system dimension the element applies to." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:BiasCategoryEnum a owl:Class ;
    rdfs:label "BiasCategoryEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#SYSTEMIC> <https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#COMPUTATIONAL_AND_STATISTICAL> <https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#HUMAN_COGNITIVE> ) ;
    skos:definition """The three major categories of AI bias identified by NIST
(Part 1 §3.7; see NIST SP 1270).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#COMPUTATIONAL_AND_STATISTICAL>,
        <https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#HUMAN_COGNITIVE>,
        <https://w3id.org/lmodel/nist-ai-rmf/BiasCategoryEnum#SYSTEMIC> .

nist_ai_rmf:FunctionEnum a owl:Class ;
    rdfs:label "FunctionEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#GOVERN> <https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#MAP> <https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#MEASURE> <https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#MANAGE> ) ;
    skos:definition """The four high-level AI RMF Core functions. GOVERN is a
cross-cutting function applied throughout; MAP, MEASURE, and MANAGE
operate on specific AI systems and lifecycle stages.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#GOVERN>,
        <https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#MANAGE>,
        <https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#MAP>,
        <https://w3id.org/lmodel/nist-ai-rmf/FunctionEnum#MEASURE> .

nist_ai_rmf:GaiRiskCategorizationEnum a owl:Class ;
    rdfs:label "GaiRiskCategorizationEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategorizationEnum#TECHNICAL_OR_MODEL_RISKS> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategorizationEnum#MISUSE_BY_HUMANS> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategorizationEnum#ECOSYSTEM_OR_SOCIETAL_RISKS> ) ;
    skos:definition """Higher-level grouping of GAI risks, derived from the UK's
International Scientific Report on the Safety of Advanced AI
(NIST AI 600-1 Section 2, footnote 5).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategorizationEnum#ECOSYSTEM_OR_SOCIETAL_RISKS>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategorizationEnum#MISUSE_BY_HUMANS>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategorizationEnum#TECHNICAL_OR_MODEL_RISKS> .

nist_ai_rmf:GaiRiskScopeEnum a owl:Class ;
    rdfs:label "GaiRiskScopeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskScopeEnum#MODEL_OR_SYSTEM> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskScopeEnum#APPLICATION_OR_IMPLEMENTATION> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskScopeEnum#ECOSYSTEM> ) ;
    skos:definition "The scope at which a GAI risk may manifest (Section 2)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskScopeEnum#APPLICATION_OR_IMPLEMENTATION>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskScopeEnum#ECOSYSTEM>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskScopeEnum#MODEL_OR_SYSTEM> .

nist_ai_rmf:HarmCategoryEnum a owl:Class ;
    rdfs:label "HarmCategoryEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_PEOPLE> <https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_AN_ORGANIZATION> <https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_AN_ECOSYSTEM> ) ;
    skos:definition "High-level categories of harm related to AI systems (Figure 1)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_AN_ECOSYSTEM>,
        <https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_AN_ORGANIZATION>,
        <https://w3id.org/lmodel/nist-ai-rmf/HarmCategoryEnum#HARM_TO_PEOPLE> .

nist_ai_rmf:HarmToPeopleSubcategoryEnum a owl:Class ;
    rdfs:label "HarmToPeopleSubcategoryEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#INDIVIDUAL> <https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#GROUP_OR_COMMUNITY> <https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#SOCIETAL> ) ;
    skos:definition "Sub-categories of harm to people, per Figure 1." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#GROUP_OR_COMMUNITY>,
        <https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#INDIVIDUAL>,
        <https://w3id.org/lmodel/nist-ai-rmf/HarmToPeopleSubcategoryEnum#SOCIETAL> .

nist_ai_rmf:StructuredFeedbackMethodEnum a owl:Class ;
    rdfs:label "StructuredFeedbackMethodEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/StructuredFeedbackMethodEnum#PARTICIPATORY_ENGAGEMENT_METHODS> <https://w3id.org/lmodel/nist-ai-rmf/StructuredFeedbackMethodEnum#FIELD_TESTING> <https://w3id.org/lmodel/nist-ai-rmf/StructuredFeedbackMethodEnum#AI_RED_TEAMING> ) ;
    skos:definition """Categories of structured public feedback for GAI risk
management (Appendix A.1.5).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/StructuredFeedbackMethodEnum#AI_RED_TEAMING>,
        <https://w3id.org/lmodel/nist-ai-rmf/StructuredFeedbackMethodEnum#FIELD_TESTING>,
        <https://w3id.org/lmodel/nist-ai-rmf/StructuredFeedbackMethodEnum#PARTICIPATORY_ENGAGEMENT_METHODS> .

nist_ai_rmf:GaiActionFunctionPrefixEnum a owl:Class ;
    rdfs:label "GaiActionFunctionPrefixEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#GV> <https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#MP> <https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#MS> <https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#MG> ) ;
    skos:definition "Two-letter function prefix used in GAI Action IDs." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#GV>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#MG>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#MP>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiActionFunctionPrefixEnum#MS> .

nist_ai_rmf:ImpactSignEnum a owl:Class ;
    rdfs:label "ImpactSignEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#POSITIVE> <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#NEGATIVE> <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#MIXED> ) ;
    skos:definition """Whether an impact of an AI system is positive, negative, or both
(Part 1 §1.1).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#MIXED>,
        <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#NEGATIVE>,
        <https://w3id.org/lmodel/nist-ai-rmf/ImpactSignEnum#POSITIVE> .

nist_ai_rmf:PrimaryConsiderationEnum a owl:Class ;
    rdfs:label "PrimaryConsiderationEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#GOVERNANCE> <https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#PRE_DEPLOYMENT_TESTING> <https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#CONTENT_PROVENANCE> <https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#INCIDENT_DISCLOSURE> ) ;
    skos:definition """The four overarching themes derived from the GAI PWG
consultation process (Appendix A).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#CONTENT_PROVENANCE>,
        <https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#GOVERNANCE>,
        <https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#INCIDENT_DISCLOSURE>,
        <https://w3id.org/lmodel/nist-ai-rmf/PrimaryConsiderationEnum#PRE_DEPLOYMENT_TESTING> .

nist_ai_rmf:ProfileTypeEnum a owl:Class ;
    rdfs:label "ProfileTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#USE_CASE> <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#TEMPORAL_CURRENT> <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#TEMPORAL_TARGET> <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#CROSS_SECTORAL> ) ;
    skos:definition "Types of AI RMF Profile (§6)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#CROSS_SECTORAL>,
        <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#TEMPORAL_CURRENT>,
        <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#TEMPORAL_TARGET>,
        <https://w3id.org/lmodel/nist-ai-rmf/ProfileTypeEnum#USE_CASE> .

nist_ai_rmf:RedTeamingTypeEnum a owl:Class ;
    rdfs:label "RedTeamingTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#GENERAL_PUBLIC> <https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#EXPERT> <https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#COMBINATION> <https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#HUMAN_AND_AI> ) ;
    skos:definition "Types of AI red-teaming exercises (Appendix A.1.5)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#COMBINATION>,
        <https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#EXPERT>,
        <https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#GENERAL_PUBLIC>,
        <https://w3id.org/lmodel/nist-ai-rmf/RedTeamingTypeEnum#HUMAN_AND_AI> .

nist_ai_rmf:RiskResponseEnum a owl:Class ;
    rdfs:label "RiskResponseEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#MITIGATING> <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#TRANSFERRING> <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#AVOIDING> <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#ACCEPTING> ) ;
    skos:definition "Treatment options for AI risks (MANAGE 1.3)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#ACCEPTING>,
        <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#AVOIDING>,
        <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#MITIGATING>,
        <https://w3id.org/lmodel/nist-ai-rmf/RiskResponseEnum#TRANSFERRING> .

nist_ai_rmf:impact_sign a owl:ObjectProperty ;
    rdfs:label "impact_sign" ;
    rdfs:range nist_ai_rmf:ImpactSignEnum ;
    skos:definition "Whether the impact is positive, negative, or both." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:is_residual a owl:DatatypeProperty ;
    rdfs:label "is_residual" ;
    rdfs:range xsd:boolean ;
    skos:definition """Whether this risk represents risk remaining after risk treatment
(residual risk per ISO Guide 73).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:likelihood a owl:DatatypeProperty ;
    rdfs:label "likelihood" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:float ;
                        owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:float ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1e+00 ] ) ] ) ] ;
    skos:closeMatch <https://w3id.org/lmodel/iso27001/LikelihoodRating> ;
    skos:definition """Estimated probability of the event occurring (0.0 to 1.0). The
AI RMF leaves quantification approaches to the implementer.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:outcome a owl:DatatypeProperty ;
    rdfs:label "outcome" ;
    rdfs:range xsd:string ;
    skos:closeMatch <https://w3id.org/lmodel/nist-csf-v2/prose> ;
    skos:definition """The outcome statement of a Category or Subcategory - the desired
result of carrying out its actions.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:profile_type a owl:ObjectProperty ;
    rdfs:label "profile_type" ;
    rdfs:range nist_ai_rmf:ProfileTypeEnum ;
    skos:definition "The kind of AI RMF Profile." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string ;
    skos:definition "A human-readable title.",
        """Subcategory identifier (e.g., "GOVERN 1.1"). Mirrors the
AI RMF Subcategory `subcategory_id`.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:trustworthiness_characteristic a owl:ObjectProperty ;
    rdfs:label "trustworthiness_characteristic" ;
    rdfs:range nist_ai_rmf:TrustworthinessCharacteristicEnum ;
    skos:definition "Trustworthiness characteristic(s) the element pertains to." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:RiskMeasurementChallengeEnum a owl:Class ;
    rdfs:label "RiskMeasurementChallengeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#THIRD_PARTY_SOFTWARE_HARDWARE_AND_DATA> <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#TRACKING_EMERGENT_RISKS> <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#AVAILABILITY_OF_RELIABLE_METRICS> <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#RISK_AT_DIFFERENT_LIFECYCLE_STAGES> <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#RISK_IN_REAL_WORLD_SETTINGS> <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#INSCRUTABILITY> <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#HUMAN_BASELINE> ) ;
    skos:definition "Challenges that complicate AI risk measurement (Part 1 §1.2.1)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#AVAILABILITY_OF_RELIABLE_METRICS>,
        <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#HUMAN_BASELINE>,
        <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#INSCRUTABILITY>,
        <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#RISK_AT_DIFFERENT_LIFECYCLE_STAGES>,
        <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#RISK_IN_REAL_WORLD_SETTINGS>,
        <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#THIRD_PARTY_SOFTWARE_HARDWARE_AND_DATA>,
        <https://w3id.org/lmodel/nist-ai-rmf/RiskMeasurementChallengeEnum#TRACKING_EMERGENT_RISKS> .

nist_ai_rmf:AiSystemDimensionEnum a owl:Class ;
    rdfs:label "AiSystemDimensionEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#APPLICATION_CONTEXT> <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#DATA_AND_INPUT> <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#AI_MODEL> <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#TASK_AND_OUTPUT> <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#PEOPLE_AND_PLANET> ) ;
    skos:definition """Key socio-technical dimensions of an AI system (Figure 2).
People and Planet sits at the centre representing human and
societal well-being.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#AI_MODEL>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#APPLICATION_CONTEXT>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#DATA_AND_INPUT>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#PEOPLE_AND_PLANET>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiSystemDimensionEnum#TASK_AND_OUTPUT> .

nist_ai_rmf:GaiRiskSourceEnum a owl:Class ;
    rdfs:label "GaiRiskSourceEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#DESIGN> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#TRAINING> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#OPERATION> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#MODEL_INPUTS> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#MODEL_OUTPUTS> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#HUMAN_BEHAVIOR> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#HUMAN_AI_INTERACTION> ) ;
    skos:definition "The source(s) from which a GAI risk may emerge (Section 2)." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#DESIGN>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#HUMAN_AI_INTERACTION>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#HUMAN_BEHAVIOR>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#MODEL_INPUTS>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#MODEL_OUTPUTS>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#OPERATION>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskSourceEnum#TRAINING> .

nist_ai_rmf:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "A human-readable description.",
        "Outcome statement of the subcategory." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:magnitude a owl:DatatypeProperty ;
    rdfs:label "magnitude" ;
    rdfs:range xsd:string ;
    skos:closeMatch <https://w3id.org/lmodel/iso27001/ImpactRating> ;
    skos:definition """Magnitude or degree of consequences if the event occurs (free
text or qualitative scale).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:TrustworthinessCharacteristicEnum a owl:Class ;
    rdfs:label "TrustworthinessCharacteristicEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE> <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SAFE> <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT> <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT> <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE> <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED> <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED> ) ;
    skos:definition """The seven characteristics of trustworthy AI systems described in
Figure 4 and Part 1 §3.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#ACCOUNTABLE_AND_TRANSPARENT>,
        <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#EXPLAINABLE_AND_INTERPRETABLE>,
        <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#FAIR_WITH_HARMFUL_BIAS_MANAGED>,
        <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#PRIVACY_ENHANCED>,
        <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SAFE>,
        <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#SECURE_AND_RESILIENT>,
        <https://w3id.org/lmodel/nist-ai-rmf/TrustworthinessCharacteristicEnum#VALID_AND_RELIABLE> .

nist_ai_rmf:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "A unique identifier for an element." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:lifecycle_stage a owl:ObjectProperty ;
    rdfs:label "lifecycle_stage" ;
    rdfs:range nist_ai_rmf:AiLifecycleStageEnum ;
    skos:definition "The AI lifecycle stage(s) the element applies to." ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

nist_ai_rmf:AiLifecycleStageEnum a owl:Class ;
    rdfs:label "AiLifecycleStageEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#PLAN_AND_DESIGN> <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA> <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#BUILD_AND_USE_MODEL> <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#VERIFY_AND_VALIDATE> <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#DEPLOY_AND_USE> <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#OPERATE_AND_MONITOR> ) ;
    skos:definition """AI lifecycle stages as defined in Figure 2 (modified from
OECD 2022). Each stage corresponds to one of the AI system
dimensions (see AiSystemDimensionEnum).""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#BUILD_AND_USE_MODEL>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#COLLECT_AND_PROCESS_DATA>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#DEPLOY_AND_USE>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#OPERATE_AND_MONITOR>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#PLAN_AND_DESIGN>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiLifecycleStageEnum#VERIFY_AND_VALIDATE> .

nist_ai_rmf:GaiRiskCategoryEnum a owl:Class ;
    rdfs:label "GaiRiskCategoryEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#CBRN_INFORMATION_OR_CAPABILITIES> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#CONFABULATION> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#DATA_PRIVACY> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#ENVIRONMENTAL_IMPACTS> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#HARMFUL_BIAS_OR_HOMOGENIZATION> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#HUMAN_AI_CONFIGURATION> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#INFORMATION_INTEGRITY> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#INFORMATION_SECURITY> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#INTELLECTUAL_PROPERTY> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#OBSCENE_DEGRADING_OR_ABUSIVE_CONTENT> <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#VALUE_CHAIN_AND_COMPONENT_INTEGRATION> ) ;
    skos:definition """The 12 risks unique to or exacerbated by Generative AI as
enumerated in NIST AI 600-1 Section 2.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#CBRN_INFORMATION_OR_CAPABILITIES>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#CONFABULATION>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#DATA_PRIVACY>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#ENVIRONMENTAL_IMPACTS>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#HARMFUL_BIAS_OR_HOMOGENIZATION>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#HUMAN_AI_CONFIGURATION>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#INFORMATION_INTEGRITY>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#INFORMATION_SECURITY>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#INTELLECTUAL_PROPERTY>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#OBSCENE_DEGRADING_OR_ABUSIVE_CONTENT>,
        <https://w3id.org/lmodel/nist-ai-rmf/GaiRiskCategoryEnum#VALUE_CHAIN_AND_COMPONENT_INTEGRATION> .

nist_ai_rmf:AiActorTaskEnum a owl:Class ;
    rdfs:label "AiActorTaskEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DESIGN> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEVELOPMENT> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEPLOYMENT> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OPERATION_AND_MONITORING> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#TEVV> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#HUMAN_FACTORS> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#DOMAIN_EXPERT> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_IMPACT_ASSESSMENT> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#PROCUREMENT> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GOVERNANCE_AND_OVERSIGHT> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#THIRD_PARTY_ENTITIES> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#END_USERS> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AFFECTED_INDIVIDUALS_OR_COMMUNITIES> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OTHER_AI_ACTORS> <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GENERAL_PUBLIC> ) ;
    skos:definition """Categories of AI actor tasks as described in Appendix A and
illustrated in Figure 3.""" ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> ;
    linkml:permissible_values <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AFFECTED_INDIVIDUALS_OR_COMMUNITIES>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEPLOYMENT>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DESIGN>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_DEVELOPMENT>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#AI_IMPACT_ASSESSMENT>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#DOMAIN_EXPERT>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#END_USERS>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GENERAL_PUBLIC>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#GOVERNANCE_AND_OVERSIGHT>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#HUMAN_FACTORS>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OPERATION_AND_MONITORING>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#OTHER_AI_ACTORS>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#PROCUREMENT>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#TEVV>,
        <https://w3id.org/lmodel/nist-ai-rmf/AiActorTaskEnum#THIRD_PARTY_ENTITIES> .

nist_ai_rmf:NamedThing a owl:Class ;
    rdfs:label "NamedThing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:description ],
        [ owl:unionOf ( nist_ai_rmf:AiActor nist_ai_rmf:AiActorTask nist_ai_rmf:AiLifecycleStage nist_ai_rmf:AiRmfDocument nist_ai_rmf:AiRmfFramework nist_ai_rmf:AiRmfProfile nist_ai_rmf:AiSpecificRisk nist_ai_rmf:AiSystem nist_ai_rmf:AiSystemDimension nist_ai_rmf:Bias nist_ai_rmf:Category nist_ai_rmf:Function nist_ai_rmf:Harm nist_ai_rmf:HumanAiInteractionIssue nist_ai_rmf:Impact nist_ai_600_1:PrimaryGaiConsideration nist_ai_rmf:Risk nist_ai_rmf:RiskMeasurementChallenge nist_ai_rmf:RiskTolerance nist_ai_rmf:RmfAttribute nist_ai_600_1:StructuredPublicFeedback nist_ai_rmf:Subcategory nist_ai_600_1:SuggestedAction nist_ai_rmf:TrustworthinessCharacteristic ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:see_also ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty nist_ai_rmf:see_also ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty nist_ai_rmf:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty nist_ai_rmf:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty nist_ai_rmf:title ] ;
    skos:closeMatch <http://schema.org/Thing> ;
    skos:definition "A generic grouping for any identifiable AI RMF element." ;
    skos:exactMatch <http://schema.org/Thing> ;
    skos:inScheme <https://w3id.org/lmodel/nist-ai-100-1> .

xsd:string a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(GOVERN|MAP|MEASURE|MANAGE) [0-9]+$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(GV|MP|MS|MG)-[0-9]+\\.[0-9]+-[0-9]{3}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(GOVERN|MAP|MEASURE|MANAGE)$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(GOVERN|MAP|MEASURE|MANAGE) [0-9]+\\.[0-9]+$" ] ) ] .


