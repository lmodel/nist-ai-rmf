	rdfs:subClassOf _:c14n103 , _:c14n151 , _:c14n202 , _:c14n251 , _:c14n284 , _:c14n366 , _:c14n398 , _:c14n468 ;
	skos:broadMatch <https://w3id.org/lmodel/oscal/Part> ;
	skos:definition "A step an organization or AI actor can take to manage GAI risks, which one row of a table states." ;
	skos:exactMatch <https://w3id.org/lmodel/nist-ai-600-1/SuggestedAction> ;
	skos:inScheme <https://w3id.org/lmodel/nist-ai-600-1/nist_ai_600_1_actions> ;
	skos:relatedMatch <https://w3id.org/lmodel/nist-ai-100-1/SuggestedAction> , <https://w3id.org/lmodel/stix/StixCourseOfAction> .
