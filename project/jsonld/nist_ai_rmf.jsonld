    {
      "name": "PrimaryGaiConsideration",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-600-1/PrimaryGaiConsideration",
      "description": "An overarching consideration derived from the NIST GAI PWG\nconsultation process (Appendix A). The `consideration_kind`\nattribute discriminates between the four primary\nconsiderations: Governance, Pre-Deployment Testing, Content\nProvenance, and Incident Disclosure.\n\nAll consideration-specific attributes are optional and apply\nto the appropriate `consideration_kind`:\n  * GOVERNANCE: governance_practices, third_party_considerations\n  * PRE_DEPLOYMENT_TESTING: limitations_of_current_approaches\n  * CONTENT_PROVENANCE: provenance_techniques\n  * INCIDENT_DISCLOSURE: ai_incident_definition",
      "in_subset": [
        "gai_considerations"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-600-1",
      "related_mappings": [
        "nist_csf:CSFProperty"
      ],
      "is_a": "NamedThing",
