      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/nist-ai-100-1/Record",
      "@type": "ClassDefinition"
    },
    {
      "name": "AiRmfTrustworthinessCharacteristic",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-100-1/AiRmfTrustworthinessCharacteristic",
      "description": "A characteristic of trustworthy AI systems, each with a subsection of section 3.",
      "comments": [
        "Addressing the characteristics one by one does not make a system trustworthy, since they trade off against each other."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_foundations",
      "exact_mappings": [
        "nist_ai_100_1:TrustworthinessCharacteristic"
      ],
      "slots": [
        "description",
        "aiRmfTrustworthinessCharacteristic__ai_rmf_characteristic_name",
        "aiRmfTrustworthinessCharacteristic__ai_rmf_characteristic_section",
        "aiRmfTrustworthinessCharacteristic__ai_rmf_characteristic_is_base",
        "aiRmfTrustworthinessCharacteristic__ai_rmf_characteristic_relates_to_all"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ai_rmf_characteristic_name",
          "description": "Which characteristic this is.",
          "range": "AiRmfCharacteristicName",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ai_rmf_characteristic_section",
