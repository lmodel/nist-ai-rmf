      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ai_rmf_resource_uuid",
          "description": "The UUID of the resource in the back matter of NIST's catalog.",
          "required": true,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "ai_rmf_resource_address",
