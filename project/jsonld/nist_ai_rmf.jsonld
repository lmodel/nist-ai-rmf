    {
      "name": "AiRmfHarm",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-100-1/AiRmfHarm",
      "description": "A negative impact, sorted as in Figure 1 by whether it falls on people, an organization or an ecosystem.",
      "from_schema": "https://w3id.org/lmodel/nist-ai-100-1/nist_ai_100_1_foundations",
      "exact_mappings": [
        "nist_ai_100_1:Harm"
      ],
      "is_a": "AiRmfImpact",
      "slots": [
        "ai_rmf_id",
        "title",
        "description",
        "ai_rmf_likelihood",
        "ai_rmf_magnitude",
        "aiRmfImpact__ai_rmf_impact_direction",
        "aiRmfImpact__ai_rmf_impact_affected_parties",
        "aiRmfHarm__ai_rmf_harm_category",
        "aiRmfHarm__ai_rmf_harm_example"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ai_rmf_harm_category",
          "description": "The heading of Figure 1 the harm falls under.",
          "range": "AiRmfHarmCategory",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ai_rmf_harm_example",
          "description": "The example of Figure 1 the harm matches, which must sit under the harm's category.",
          "range": "AiRmfHarmExample",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-ai-100-1/Harm",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "ai_rmf_harm_category",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "ai_rmf_impact_direction",
                "equals_string": "negative",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A harm is a negative impact.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "ai_rmf_harm_category",
                "equals_string": "people",
                "@type": "SlotDefinition"
              },
              {
                "name": "ai_rmf_harm_example",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "ai_rmf_harm_example",
                "any_of": [
                  {
                    "equals_string": "individual",
                    "@type": "AnonymousSlotExpression"
                  },
                  {
                    "equals_string": "group_or_community",
                    "@type": "AnonymousSlotExpression"
                  },
                  {
                    "equals_string": "societal",
                    "@type": "AnonymousSlotExpression"
                  }
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "An example of harm to people goes with harm to people.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "ai_rmf_harm_category",
                "equals_string": "organization",
                "@type": "SlotDefinition"
              },
              {
                "name": "ai_rmf_harm_example",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "ai_rmf_harm_example",
                "any_of": [
                  {
                    "equals_string": "business_operations",
                    "@type": "AnonymousSlotExpression"
                  },
                  {
                    "equals_string": "security_breach_or_monetary_loss",
                    "@type": "AnonymousSlotExpression"
                  },
                  {
                    "equals_string": "reputation",
                    "@type": "AnonymousSlotExpression"
                  }
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "An example of harm to an organization goes with harm to an organization.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "ai_rmf_harm_category",
                "equals_string": "ecosystem",
                "@type": "SlotDefinition"
              },
              {
                "name": "ai_rmf_harm_example",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "ai_rmf_harm_example",
                "any_of": [
                  {
                    "equals_string": "interdependent_elements",
                    "@type": "AnonymousSlotExpression"
                  },
                  {
                    "equals_string": "financial_or_supply_systems",
                    "@type": "AnonymousSlotExpression"
                  },
                  {
                    "equals_string": "natural_resources_and_environment",
                    "@type": "AnonymousSlotExpression"
                  }
                ],
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "An example of harm to an ecosystem goes with harm to an ecosystem.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
