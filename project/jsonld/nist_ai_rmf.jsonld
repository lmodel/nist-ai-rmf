        {
          "name": "ai_rmf_subcategory_suggested_actions",
          "description": "The steps the Playbook suggests towards the outcome. They are voluntary and are not a checklist.",
          "range": "AiRmfSuggestedAction",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ai_rmf_subcategory_documentation",
          "description": "What the Playbook suggests an organization document, mostly as questions.",
          "range": "AiRmfDocumentationItem",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ai_rmf_subcategory_transparency_resources",
          "description": "The sources the Playbook names as AI transparency resources.",
          "range": "AiRmfResource",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ai_rmf_subcategory_references",
          "description": "The Playbook's references for the outcome.",
