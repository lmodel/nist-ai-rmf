    {
      "name": "AiRmfFramework",
      "definition_uri": "https://w3id.org/lmodel/nist-ai-100-1/AiRmfFramework",
      "description": "Root container that bundles the AI RMF Core (Functions) with\nfoundational concepts (trustworthiness characteristics,\nlifecycle, actors, risks, harms), profiles, and Framework\nattributes. Designed for serialising the Framework or a tailored\ninstance of it as a single JSON / YAML document.",
      "in_subset": [
        "base"
      ],
      "from_schema": "https://w3id.org/lmodel/nist-ai-100-1",
      "close_mappings": [
        "nist_csf:CSFDocument",
        "oscal_catalog:Catalog",
        "nist_sp_800_53:Catalog"
      ],
      "is_a": "NamedThing",
      "slots": [
        "id",
        "name",
        "title",
        "description",
        "see_also",
        "document",
        "functions",
        "trustworthiness_characteristics",
        "lifecycle_stages",
        "dimensions",
        "actor_tasks",
        "profiles",
        "attributes",
        "risk_measurement_challenges",
        "ai_specific_risks",
        "human_ai_interaction_issues"
